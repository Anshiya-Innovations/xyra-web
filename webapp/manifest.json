{
  "_version": "1.86.0",
  "sap.app": {
    "id": "xyraweb",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,

    "rootView": {
      "viewName": "xyraweb.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    },

    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.tnt": {},
        "sap.f": {},
        "sap.viz": {}
      }
    },

    "contentDensities": {
      "compact": true,
      "cozy": true
    },

    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "xyraweb.i18n.i18n",
          "supportedLocales": ["en", ""],
          "fallbackLocale": "en"
        }
      }
    },

    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },

    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "xyraweb.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true,
        "transition": "slide",
        "clearControlAggregation": true
      },

      "routes": [
        {
          "name": "Login",
          "pattern": "",
          "target": "Login"
        },
        {
          "name": "Admin",
          "pattern": "Admin",
          "target": "Admin"
        },
        {
          "name": "EscalationManager",
          "pattern": "EscalationManager",
          "target": "EscalationManager"
        },
        {
          "name": "Reviewer1",
          "pattern": "Reviewer1",
          "target": "Reviewer1"
        },
        {
          "name": "Reviewer1Queue",
          "pattern": "Reviewer1/Queue",
          "target": "Reviewer1"
        },
        {
          "name": "Reviewer1Analysis",
          "pattern": "Reviewer1/Analysis/:reportId:",
          "target": "Reviewer1"
        },
        {
          "name": "Reviewer1History",
          "pattern": "Reviewer1/History",
          "target": "Reviewer1"
        },
        {
          "name": "Reviewer1Profile",
          "pattern": "Reviewer1/Profile",
          "target": "Reviewer1Profile"
        },
        {
          "name": "Reviewer2",
          "pattern": "Reviewer2",
          "target": "Reviewer2"
        },
        {
          "name": "Auditor",
          "pattern": "Auditor",
          "target": "Auditor"
        },
        {
          "name": "AccessManagement",
          "pattern": "AccessManagement",
          "target": "AccessManagement"
        },
        {
          "name": "Configuration",
          "pattern": "Configuration",
          "target": "Configuration"
        },
        {
          "name": "Profile",
          "pattern": "Profile",
          "target": "Profile"
        },
        {
          "name": "ControlManagement",
          "pattern": "ControlManagement",
          "target": "ControlManagement"
        },
        {
          "name": "AutomationMonitoring",
          "pattern": "AutomationMonitoring",
          "target": "AutomationMonitoring"
        },

        {
          "name": "RoleReview",
          "pattern": "RoleReview",
          "target": "RoleReview"
        },
        {
          "name": "Reports",
          "pattern": "Reports",
          "target": "Reports"
        },
        {
          "name": "AuditLogs",
          "pattern": "AuditLogs",
          "target": "AuditLogs"
        },
        {
          "name": "SOXCompliance",
          "pattern": "SOXCompliance",
          "target": "SOXCompliance"
        },
        {
          "name": "DeviationReport",
          "pattern": "DeviationReport",
          "target": "DeviationReport"
        },
        {
          "name": "AlertItem",
          "pattern": "AlertItem/:alertId:/:controlId:",
          "target": "AlertItem"
        },
        {
          "name": "SystemHealth",
          "pattern": "SystemHealth",
          "target": "Configuration"
        },
        {
          "name": "SystemHealthDetails",
          "pattern": "SystemHealthDetails/:systemId:",
          "target": "SystemHealthDetails"
        }
      ],

      "targets": {
        "Login": {
          "viewName": "Login"
        },
        "Admin": {
          "viewName": "Admin"
        },
        "EscalationManager": {
          "viewName": "EscalationManager"
        },
        "Reviewer1": {
          "viewName": "Reviewer1"
        },
        "Reviewer1Profile": {
          "viewName": "Reviewer1Profile"
        },
        "Reviewer2": {
          "viewName": "Reviewer2"
        },
        "Auditor": {
          "viewName": "Auditor"
        },
        "AccessManagement": {
          "viewName": "AccessManagement"
        },
        "Configuration": {
          "viewName": "Configuration"
        },
        "SystemHealth": {
          "viewName": "SystemHealth"
        },
        "SystemHealthDetails": {
          "viewName": "SystemHealthDetails"
        },
        "Profile": {
          "viewName": "Profile"
        },
        "ControlManagement": {
          "viewName": "ControlManagement"
        },
        "AutomationMonitoring": {
          "viewName": "AutomationMonitoring"
        },

        "RoleReview": {
          "viewName": "RoleReview"
        },
        "Reports": {
          "viewName": "Reports"
        },
        "AuditLogs": {
          "viewName": "AuditLogs"
        },
        "SOXCompliance": {
          "viewName": "SOXCompliance"
        },
        "DeviationReport": {
          "viewName": "DeviationReport"
        },
        "AlertItem": {
          "viewName": "AlertItem"
        }
      }
    }
  }
}