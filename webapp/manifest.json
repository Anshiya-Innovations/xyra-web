{
  "_version": "1.86.0",
  "sap.app": {
    "id": "xyraweb",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
  "flexEnabled": true,

  "rootView": {
    "viewName": "xyraweb.view.App",
    "type": "XML",
    "id": "App",
    "async": true
  },

  "dependencies": {
    "minUI5Version": "1.150.0",
    "libs": {
      "sap.m": {},
      "sap.ui.core": {},
      "sap.ui.layout": {}
    }
  },

  "contentDensities": {
    "compact": true,
    "cozy": true
  },

  "models": {
    "i18n": {
      "type": "sap.ui.model.resource.ResourceModel",
      "settings": {
        "bundleName": "xyraweb.i18n.i18n"
      }
    }
  },

  "resources": {
    "css": [
      {
        "uri": "css/style.css"
      }
    ]
  },

  "routing": {
    "config": {
      "routerClass": "sap.m.routing.Router",
      "viewType": "XML",
      "viewPath": "xyraweb.view",
      "controlId": "app",
      "controlAggregation": "pages",
      "async": true,
      "transition": "slide",
      "clearControlAggregation": false
    },

    "routes": [
      {
        "name": "Login",
        "pattern": "",
        "target": "Login"
      },
      {
        "name": "Admin",
        "pattern": "Admin",
        "target": "Admin"
      },
      {
        "name": "EscalationManager",
        "pattern": "EscalationManager",
        "target":  "EscalationManager"
      },
      {
        "name": "Reviewer1",
        "pattern": "Reviewer1",
        "target": "Reviewer1"
      },
      {
        "name": "Reviewer2",
        "pattern": "Reviewer2",
        "target": "Reviewer2"
      },
      
      {
        "name": "Auditor",
        "pattern": "Auditor",
        "target": "Auditor"
      },
      {
        "name": "AccessManagement",
        "pattern": "AccessManagement",
        "target": "AccessManagement"
      }
    ],

    "targets": {

      "Login": {
        "viewId": "Login",
        "viewName": "Login"
      },

      "Admin": {
        "viewId": "Admin",
        "viewName": "Admin"
      },

      "EscalationManager": {
        "viewId": "EscalationManager",
        "viewName": "EscalationManager"
      },

      "Reviewer1": {
        "viewId": "Reviewer1",
        "viewName": "Reviewer1"
      },

      "Reviewer2": {
        "viewId": "Reviewer2",
        "viewName": "Reviewer2"
      },

      "Auditor": {
        "viewId": "Auditor",
        "viewName": "Auditor"
      },

      "AccessManagement": {
        "viewId": "AccessManagement",
        "viewName": "AccessManagement"
      }

    }

  }

  }
}