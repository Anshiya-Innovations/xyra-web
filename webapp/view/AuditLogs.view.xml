<mvc:View
    controllerName="xyraweb.controller.AuditLogs"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="auditLogsToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="AuditLogs" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://shield" key="Admin" select="onAdmin"/>


                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement">
                        <tnt:tag>
                            <ObjectStatus text="156 Controls" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://machine" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://business-objects-experience" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="System Health" icon="sap-icon://sys-monitor" key="SystemHealth" select="onSystemHealth"/>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="auditLogsPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <Avatar initials="AL" displaySize="S" backgroundColor="Accent6" class="sapUiTinyMarginEnd"/>
                        <VBox justifyContent="Center">
                            <Title text="📜 XYRA – Audit Logs" level="H4" class="sapUiNoMargin"/>
                            <Text text="SAP Security Audit Configuration Validation Dashboard" class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Admin Dashboard" type="Transparent" press="onAdmin" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- AUTOMATION PROCESS BANNER -->
                        <MessageStrip
                            text="Automation Process Active: 1. Extract Audit Logging Configuration. 2. Compare against Security Control Standards (SCS). 3. Detect configuration deviations. 4. If deviation exists: Generate report &amp; escalate to Reviewer 1. 5. If no deviation exists: Store validation history."
                            type="Information"
                            showIcon="true"
                            showCloseButton="false"
                            class="sapUiSmallMarginBottom"/>

                        <!-- TAB NAVIGATION BUTTONS (SLIDE BUTTONS) -->
                        <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Button id="btnTabValidationResults" text="Configuration Validation Results" icon="sap-icon://table-view" type="Emphasized" press="onSelectTabResults" class="sapUiTinyMarginEnd"/>
                            <Button id="btnTabValidationHistory" text="Validation History" icon="sap-icon://history" type="Transparent" press="onSelectTabHistory"/>
                        </HBox>

                        <!-- SLIDE 1: CONFIGURATION VALIDATION RESULTS -->
                        <VBox id="vboxValidationResults" visible="true" width="100%">
                            <!-- QUICK ACTIONS TOOLBAR -->
                            <Panel expandable="false" class="sapUiSmallMarginBottom">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Quick Actions" level="H4"/>
                                        <ToolbarSpacer/>
                                        <Button text="Validate Configuration" icon="sap-icon://accept" type="Emphasized" press="onValidateConfiguration" class="sapUiTinyMarginEnd"/>
                                        <Button text="Export PDF" icon="sap-icon://pdf-attachment" type="Default" press="onExportPDF" class="sapUiTinyMarginEnd"/>
                                        <Button text="Export Excel" icon="sap-icon://excel-attachment" type="Default" press="onExportExcel"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                            </Panel>

                            <!-- CONFIGURATION VALIDATION RESULTS TABLE -->
                            <Panel expandable="false" class="sapUiSmallMarginBottom">
                                <Table id="validationResultsTable" items="{auditLogsModel>/validationResults}" mode="MultiSelect" width="100%">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Title text="Configuration Validation Results" level="H3"/>
                                            <ToolbarSpacer/>
                                            <SearchField width="16rem" placeholder="Search validation results..." search="onSearchValidationResults"/>
                                            <Select id="selectControlFilter" selectedKey="All" change="onFilterControlId">
                                                <core:Item key="All" text="All Control IDs"/>
                                                <core:Item key="LOG08" text="LOG08 (SAP Java Audit Log)"/>
                                                <core:Item key="LOG28" text="LOG28 (SAP HANA Audit Log)"/>
                                            </Select>
                                            <Select id="selectResultFilter" selectedKey="All" change="onFilterValidationResult">
                                                <core:Item key="All" text="All Results"/>
                                                <core:Item key="Validated" text="Validated"/>
                                                <core:Item key="Deviation" text="Deviation"/>
                                                <core:Item key="Needs Review" text="Needs Review"/>
                                            </Select>
                                        </OverflowToolbar>
                                    </headerToolbar>

                                    <columns>
                                        <Column width="10%"><Text text="Control ID"/></Column>
                                        <Column width="16%"><Text text="SAP System"/></Column>
                                        <Column width="12%"><Text text="Environment"/></Column>
                                        <Column width="22%"><Text text="Parameter"/></Column>
                                        <Column width="13%"><Text text="Standard Value"/></Column>
                                        <Column width="13%"><Text text="Current Value"/></Column>
                                        <Column width="14%"><Text text="Validation Result"/></Column>
                                        <Column width="16%"><Text text="Reviewer Status"/></Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <ObjectStatus text="{auditLogsModel>controlId}" state="Information"/>
                                                <ObjectIdentifier title="{auditLogsModel>system}"/>
                                                <Text text="{auditLogsModel>environment}"/>
                                                <Text text="{auditLogsModel>parameter}"/>
                                                <Text text="{auditLogsModel>standardValue}"/>
                                                <Text text="{auditLogsModel>currentValue}"/>
                                                <ObjectStatus text="{auditLogsModel>validationResult}" state="{auditLogsModel>resultState}"/>
                                                <ObjectStatus text="{auditLogsModel>reviewerStatus}" state="{auditLogsModel>reviewerState}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Panel>
                        </VBox>

                        <!-- SLIDE 2: VALIDATION HISTORY -->
                        <VBox id="vboxValidationHistory" visible="false" width="100%">
                            <Panel expandable="false" class="sapUiSmallMarginBottom">
                                <Table id="validationHistoryTable" items="{auditLogsModel>/validationHistory}" mode="None" width="100%">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Title text="Validation History" level="H3"/>
                                            <ToolbarSpacer/>
                                            <SearchField width="16rem" placeholder="Search history..." search="onSearchHistory"/>
                                        </OverflowToolbar>
                                    </headerToolbar>

                                    <columns>
                                        <Column width="18%"><Text text="Execution Time"/></Column>
                                        <Column width="25%"><Text text="Control ID &amp; Scope"/></Column>
                                        <Column width="22%"><Text text="Validated By"/></Column>
                                        <Column width="13%"><Text text="Status"/></Column>
                                        <Column width="12%"><Text text="Deviation Count"/></Column>
                                        <Column width="10%" hAlign="Center"><Text text="Action"/></Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{auditLogsModel>executionTime}"/>
                                                <ObjectIdentifier title="{auditLogsModel>scope}"/>
                                                <Text text="{auditLogsModel>validatedBy}"/>
                                                <ObjectStatus text="{auditLogsModel>status}" state="{auditLogsModel>statusState}"/>
                                                <ObjectStatus text="{auditLogsModel>deviationCount}" state="{auditLogsModel>deviationState}"/>
                                                <Button text="Report" icon="sap-icon://pdf-attachment" type="Transparent" press="onViewReportDetails"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Panel>
                        </VBox>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <Text text="XYRA SAP Internal Controls Platform | Version 1.0 | Status: Active"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
