<mvc:View
    controllerName="xyraweb.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="loginPage"
        showHeader="false"
        enableScrolling="false"
        class="sapUiNoContentPadding">

        <content>

            <HBox fitContainer="true" renderType="Div" class="xyraLoginSplit">

            <FlexBox
                id="loginContainer"
                fitContainer="true"
                justifyContent="Center"
                alignItems="Center"
                direction="Column"
                renderType="Div"
                class="xyraLoginBg xyraLoginPane">

                <VBox id="_IDGenVBox"
                    width="100%"
                    alignItems="Stretch"
                    class="xyraLoginCard">

                    <Image src="img/logo.png" alt="Xyra" class="xyraLoginLogo"/>

                    <Title id="_IDGenTitle"
                        text="Welcome back"
                        level="H2"
                        textAlign="Begin"
                        width="100%"
                        class="xyraLoginTitle"/>

                    <Text id="_IDGenText"
                        text="Sign in to continue to Xyra Control Monitoring"
                        textAlign="Begin"
                        width="100%"
                        wrapping="true"
                        class="xyraLoginSubtitle"/>

                    <Label id="_IDGenLabel"
                        text="Persona"
                        required="true"
                        class="xyraLoginLabel"/>

                    <Select
                        id="role"
                        width="100%"
                        change="onRoleChange"
                        class="xyraLoginField">

                        <items>
                            <core:Item id="_IDGenItem" key="" text="-- Select Persona --"/>
                            <core:Item id="_IDGenItem1" key="ADMIN" text="Admin"/>
                            <core:Item id="_IDGenItem2" key="ACM" text="Escalation Manager"/>
                            <core:Item id="_IDGenItem3" key="REV1" text="Reviewer 1"/>
                            <core:Item id="_IDGenItem4" key="REV2" text="Reviewer 2"/>

                            <core:Item id="_IDGenItem6" key="AUDITOR" text="Auditor"/>
                        </items>

                    </Select>

                    <Label id="_IDGenLabel1"
                        text="Email"
                        required="true"
                        class="xyraLoginLabel"/>

                    <Input
                        id="username"
                        width="100%"
                        type="Email"
                        placeholder="Enter Email"
                        liveChange="onEmailLiveChange"
                        submit="onLogin"
                        class="xyraLoginField"/>

                    <CheckBox
                        id="_IDGenCheckBox"
                        text="Remember Me"
                        class="xyraLoginCheckbox"/>

                    <Button id="_IDGenButton"
                        text="Sign In"
                        type="Emphasized"
                        width="100%"
                        press="onLogin"
                        class="xyraLoginBtn"/>

                    <VBox id="_IDGenVBox1"
                        width="100%"
                        alignItems="Center"
                        class="xyraLoginFooter">

                        <Text id="_IDGenText1" text="Version 1.0.0"/>
                        <Text id="_IDGenText2" text="© 2026 Forte Innovations"/>

                    </VBox>

                </VBox>

            </FlexBox>

            <FlexBox
                id="xyraLoginHeroPane"
                fitContainer="true"
                justifyContent="Center"
                alignItems="Center"
                direction="Column"
                renderType="Div"
                class="xyraLoginHeroPane">

                <!-- Slides Wrapper -->
                <FlexBox
                    id="xyraHeroSlidesWrapper"
                    fitContainer="true"
                    justifyContent="Center"
                    alignItems="Center"
                    renderType="Div"
                    class="xyraHeroSlidesWrapper">

                    <!-- Slide 1: Overview & Trend -->
                    <VBox id="xyraSlide1" class="xyraHeroSlide xyraHeroSlideActive" width="100%" alignItems="Center">
                        <FlexBox class="xyraHeroShowcase" justifyContent="Center" alignItems="Center" width="100%">
                            <Image src="img/login-slide1.png" alt="Xyra Overview Dashboard" class="xyraHeroImg" densityAware="false"/>
                        </FlexBox>
                    </VBox>

                    <!-- Slide 2: Control Management -->
                    <VBox id="xyraSlide2" class="xyraHeroSlide" width="100%" alignItems="Center">
                        <FlexBox class="xyraHeroShowcase" justifyContent="Center" alignItems="Center" width="100%">
                            <Image src="img/login-slide2.png" alt="Xyra Control Management" class="xyraHeroImg" densityAware="false"/>
                        </FlexBox>
                    </VBox>

                    <!-- Slide 3: SOX Compliance -->
                    <VBox id="xyraSlide3" class="xyraHeroSlide" width="100%" alignItems="Center">
                        <FlexBox class="xyraHeroShowcase" justifyContent="Center" alignItems="Center" width="100%">
                            <Image src="img/login-slide3.png" alt="Xyra SOX Compliance" class="xyraHeroImg" densityAware="false"/>
                        </FlexBox>
                    </VBox>

                </FlexBox>

                <!-- Bottom Center Animated Slide Indicator Bar -->
                <core:HTML
                    id="xyraSlideIndicatorsHtml"
                    content='&lt;div class="xyraHeroIndicators" id="xyraHeroIndicators"&gt;&lt;div class="xyraHeroBar xyraHeroBarActive" id="xyraHeroBar1" title="Slide 1: Overview"&gt;&lt;/div&gt;&lt;div class="xyraHeroBar" id="xyraHeroBar2" title="Slide 2: Control Management"&gt;&lt;/div&gt;&lt;div class="xyraHeroBar" id="xyraHeroBar3" title="Slide 3: SOX Compliance"&gt;&lt;/div&gt;&lt;/div&gt;' />

            </FlexBox>

            </HBox>

        </content>

    </Page>

</mvc:View>
