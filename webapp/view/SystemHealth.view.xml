<mvc:View
    controllerName="xyraweb.controller.SystemHealth"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="systemHealthToolPage" sideExpanded="true">

        <!-- ENTERPRISE NAVIGATION SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="Configuration" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://home" key="Admin" select="onAdmin"/>
                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement"/>
                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://lightbulb" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                    <tnt:NavigationListItem text="Reports" icon="sap-icon://document-text" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    
                    <tnt:NavigationListItem text="System Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>

                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>
                    <tnt:NavigationListItem text="Organization" icon="sap-icon://building" key="Organization" select="onOrganization"/>
                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="systemHealthPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <!-- PAGE HEADER WITH TITLE, SUBTITLE & CONTROLS -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <Avatar src="sap-icon://action-settings" displaySize="S" class="sapUiTinyMarginEnd"/>
                        <VBox justifyContent="Center">
                            <Title text="XYRA – System Configuration" level="H4" class="sapUiNoMargin"/>
                            <Text text="Manage &amp; monitor SAP S/4HANA &amp; ERP System Landscape telemetry" class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <!-- HEADER ACTION CONTROLS -->
                        <HBox alignItems="Center" class="sapUiMediumMarginEnd">
                            <Text text="Auto Refresh:" class="sapUiTinyMarginEnd fontWeightBold"/>
                            <Switch id="autoRefreshSwitch" state="false" change="onAutoRefreshToggle" customTextOn="ON" customTextOff="OFF" class="sapUiSmallMarginEnd"/>
                        </HBox>
                        <Button text="Refresh" icon="sap-icon://refresh" type="Emphasized" press="onRefreshHealth" class="sapUiSmallMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Alert Notifications" type="Transparent" press="onNotificationPress" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- TAB NAVIGATION BUTTONS (SAME AS CONTROL MANAGEMENT) -->
                        <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Button
                                text="System Landscape"
                                icon="sap-icon://chain-link"
                                type="Transparent"
                                press="onConfiguration"
                                class="sapUiTinyMarginEnd"/>
                            <Button
                                text="System Health"
                                icon="sap-icon://sys-monitor"
                                type="Emphasized"/>
                        </HBox>

                        <!-- HEALTH KPI CARDS SUMMARY BAR -->
                        <HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <!-- ONLINE SYSTEMS -->
                            <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer" style="background:#f8fafc; border-radius:8px; border-left:4px solid #10b981; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="Online Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                        <Title text="{healthModel>/kpis/online}" level="H2" class="sapUiTinyMarginTop textSuccess fontWeightBold"/>
                                    </VBox>
                                    <Avatar src="sap-icon://sys-enter-2" backgroundColor="Accent8" displaySize="M"/>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                    <ObjectStatus text="🟢 Operational" state="Success"/>
                                    <Text text="SLA: 99.98%" class="fontSizeSmall textMuted sapUiTinyMarginBegin"/>
                                </HBox>
                            </VBox>

                            <!-- OFFLINE SYSTEMS -->
                            <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer" style="background:#f8fafc; border-radius:8px; border-left:4px solid #ef4444; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="Offline Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                        <Title text="{healthModel>/kpis/offline}" level="H2" class="sapUiTinyMarginTop textDanger fontWeightBold"/>
                                    </VBox>
                                    <Avatar src="sap-icon://sys-cancel-2" backgroundColor="Accent1" displaySize="M"/>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                    <ObjectStatus text="🔴 Connection Failure" state="Error"/>
                                    <Text text="Alert Active" class="fontSizeSmall textDanger fontWeightBold sapUiTinyMarginBegin"/>
                                </HBox>
                            </VBox>

                            <!-- DEGRADED SYSTEMS -->
                            <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer" style="background:#f8fafc; border-radius:8px; border-left:4px solid #f59e0b; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="Degraded Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                        <Title text="{healthModel>/kpis/degraded}" level="H2" class="sapUiTinyMarginTop textWarning fontWeightBold"/>
                                    </VBox>
                                    <Avatar src="sap-icon://alert" backgroundColor="Accent3" displaySize="M"/>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                    <ObjectStatus text="🟠 High Latency" state="Warning"/>
                                    <Text text="Latency > 120ms" class="fontSizeSmall textWarning sapUiTinyMarginBegin"/>
                                </HBox>
                            </VBox>

                            <!-- MAINTENANCE SYSTEMS -->
                            <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer" style="background:#f8fafc; border-radius:8px; border-left:4px solid #3b82f6; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="Maintenance Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                        <Title text="{healthModel>/kpis/maintenance}" level="H2" class="sapUiTinyMarginTop textPrimary fontWeightBold"/>
                                    </VBox>
                                    <Avatar src="sap-icon://settings" backgroundColor="Accent6" displaySize="M"/>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                    <ObjectStatus text="⚙ Scheduled Patch" state="Information"/>
                                    <Text text="Window Active" class="fontSizeSmall textMuted sapUiTinyMarginBegin"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- CONTROLS & FILTER BAR -->
                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <SearchField id="searchHealthSystemId" width="18rem" placeholder="Search System ID / Type..." liveChange="onSearchHealthSystems" search="onSearchHealthSystems" class="sapUiSmallMarginEnd"/>
                                <Text text="Status Filter:" class="sapUiTinyMarginEnd fontWeightBold textMuted"/>
                                <Select id="statusFilterSelect" width="12rem" change="onFilterStatusChange" selectedKey="All">
                                    <core:Item key="All" text="All Statuses"/>
                                    <core:Item key="Online" text="🟢 Online"/>
                                    <core:Item key="Offline" text="🔴 Offline"/>
                                    <core:Item key="Degraded" text="🟠 Degraded"/>
                                    <core:Item key="Maintenance" text="⚙ Maintenance"/>
                                </Select>
                            </HBox>
                            <Button text="Test All Connections" icon="sap-icon://connected" type="Default" press="onTestAllConnections"/>
                        </HBox>

                        <!-- LIVE SYSTEM HEALTH MONITORING TABLE -->
                        <Panel expandable="false" headerText="SAP Landscape Runtime Health &amp; Availability Matrix" class="sapUiSmallMarginBottom">
                            <Table id="healthTable" items="{healthModel>/systems}" mode="None" width="100%">
                                <columns>
                                    <Column width="14%"><Text text="System ID" class="fontWeightBold"/></Column>
                                    <Column width="15%"><Text text="System Type"/></Column>
                                    <Column width="10%"><Text text="Client"/></Column>
                                    <Column width="16%"><Text text="Status"/></Column>
                                    <Column width="19%"><Text text="Last Health Check"/></Column>
                                    <Column width="14%"><Text text="Connection Status"/></Column>
                                    <Column width="12%" hAlign="Center"><Text text="Action"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Link text="{healthModel>sysId}" press="onSystemIdPress" class="fontWeightBold fontSizeMedium"/>
                                            <ObjectStatus text="{healthModel>sysType}" state="{= ${healthModel>sysType} === 'Production' ? 'Error' : (${healthModel>sysType} === 'Quality' ? 'Warning' : 'Information') }"/>
                                            <Text text="{healthModel>client}"/>
                                            <ObjectStatus text="{healthModel>status}" state="{healthModel>statusState}" icon="{healthModel>statusIcon}"/>
                                            <Text text="{healthModel>lastCheck}" class="fontSizeSmall textMuted"/>
                                            <Text text="{healthModel>connectionStatus}"/>
                                            <HBox justifyContent="Center" alignItems="Center">
                                                <Button icon="sap-icon://chain-link" type="Transparent" press="onTestSingleConnection" tooltip="Test RFC Connection" class="sapUiTinyMarginEnd"/>
                                                <Button icon="sap-icon://slim-arrow-right" type="Emphasized" press="onSystemIdPress" tooltip="View System Health Details"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <Text text="System Health Monitoring Service v2.4 | RFC Telemetry Engine: Active"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
