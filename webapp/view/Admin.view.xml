<mvc:View
    controllerName="xyraweb.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
    height="100%">

    <tnt:ToolPage id="adminToolPage" sideExpanded="true">

        <tnt:sideContent>
                        <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="Admin" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://home" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement"/>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://lightbulb" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://document-text" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="System Health" icon="sap-icon://sys-monitor" key="SystemHealth" select="onSystemHealth"/>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="adminPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <dependents>
                    <ResponsivePopover
                        id="adminProfilePopover"
                        title="Administrator Profile"
                        placement="Bottom"
                        contentWidth="320px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <Avatar displaySize="M" initials="SA" backgroundColor="Accent6" class="sapUiSmallMarginEnd"/>
                                    <VBox>
                                        <Title text="System Administrator" level="H3"/>
                                        <Text text="Global Administrator"/>
                                        <ObjectStatus text="Online" state="Success"/>
                                    </VBox>
                                </HBox>
                                <VBox class="sapUiSmallMarginBottom">
                                    <Label text="Admin ID" design="Bold"/>
                                    <Text text="ADM001"/>
                                    <Label text="Department" design="Bold" class="sapUiTinyMarginTop"/>
                                    <Text text="Security &amp; Compliance"/>
                                    <Label text="Email" design="Bold" class="sapUiTinyMarginTop"/>
                                    <Text text="admin@xyra.ai"/>
                                    <Label text="Last Login" design="Bold" class="sapUiTinyMarginTop"/>
                                    <Text text="Current Session"/>
                                    <Label text="Theme / Language" design="Bold" class="sapUiTinyMarginTop"/>
                                    <Text text="SAP Horizon / English"/>
                                </VBox>
                                <HBox justifyContent="End" class="sapUiSmallMarginTop">
                                    <Button text="Profile" icon="sap-icon://person-placeholder" type="Transparent" class="sapUiTinyMarginEnd" press="onProfile"/>
                                    <Button text="Logout" icon="sap-icon://log" type="Reject" press="onLogout"/>
                                </HBox>
                            </VBox>
                        </content>
                    </ResponsivePopover>
                </dependents>

                <customHeader>
                    <OverflowToolbar height="4.5rem" class="sapUiSmallMarginBottom">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"/>

                        <VBox justifyContent="Center" class="sapUiTinyMarginBegin">
                            <Title text="Admin Dashboard" level="H4" class="sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>
                        <Button id="_IDGenButton2" icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://search" tooltip="Search" type="Transparent" press="onSearchPress"/>
                        <Button icon="sap-icon://action-settings" tooltip="Settings" type="Transparent" press="onConfiguration"/>
                        <Button icon="sap-icon://sys-help" tooltip="Help" type="Transparent" press="onHelpPress"/>
                        <Button id="_IDGenButton3" icon="sap-icon://employee" text="Admin" type="Transparent" press="onAdminProfilePress"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox id="_IDGenVBox2" width="100%" class="sapUiSmallMargin">

                        <!-- PRIMARY KPI CARDS -->
                        <Title text="Compliance Posture" level="H3" class="sapUiSmallMarginBottom"/>

                        <HBox wrap="Wrap" class="xyraKpiRow sapUiSmallMarginBottom">
                            <VBox class="xyraKpiCard">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                    <Text text="Total Controls" class="xyraKpiLabel"/>
                                    <VBox class="xyraKpiIcon xyraKpiIconPurple" alignItems="Center" justifyContent="Center">
                                        <core:Icon src="sap-icon://shield"/>
                                    </VBox>
                                </HBox>
                                <Text text="156" class="xyraKpiValue"/>
                                <Text text="↑ 12 this week" class="xyraKpiTrendUp sapUiTinyMarginTop"/>
                            </VBox>

                            <VBox class="xyraKpiCard">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                    <Text text="Compliant" class="xyraKpiLabel"/>
                                    <VBox class="xyraKpiIcon xyraKpiIconGreen" alignItems="Center" justifyContent="Center">
                                        <core:Icon src="sap-icon://sys-enter-2"/>
                                    </VBox>
                                </HBox>
                                <Text text="143" class="xyraKpiValue"/>
                                <Text text="↑ 91.7% of total" class="xyraKpiTrendUp sapUiTinyMarginTop"/>
                            </VBox>

                            <VBox class="xyraKpiCard">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                    <Text text="At Risk" class="xyraKpiLabel"/>
                                    <VBox class="xyraKpiIcon xyraKpiIconAmber" alignItems="Center" justifyContent="Center">
                                        <core:Icon src="sap-icon://alert"/>
                                    </VBox>
                                </HBox>
                                <Text text="8" class="xyraKpiValue"/>
                                <Text text="5.1% of total" class="xyraKpiLabel sapUiTinyMarginTop"/>
                            </VBox>

                            <VBox class="xyraKpiCard">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                    <Text text="Failed" class="xyraKpiLabel"/>
                                    <VBox class="xyraKpiIcon xyraKpiIconRed" alignItems="Center" justifyContent="Center">
                                        <core:Icon src="sap-icon://decline"/>
                                    </VBox>
                                </HBox>
                                <Text text="5" class="xyraKpiValue"/>
                                <Text text="↓ 3.2% of total" class="xyraKpiTrendDown sapUiTinyMarginTop"/>
                            </VBox>
                        </HBox>

                        <!-- SECONDARY OPERATIONAL STATS -->
                        <HBox wrap="Wrap" class="xyraKpiRow sapUiSmallMarginBottom">
                            <VBox class="xyraStatChip">
                                <Text text="Active Users" class="xyraKpiLabel"/>
                                <Text text="1,420" class="xyraKpiValue"/>
                            </VBox>
                            <VBox class="xyraStatChip">
                                <Text text="Configured Roles" class="xyraKpiLabel"/>
                                <Text text="380" class="xyraKpiValue"/>
                            </VBox>
                            <VBox class="xyraStatChip">
                                <Text text="Open Reviews" class="xyraKpiLabel"/>
                                <Text text="24" class="xyraKpiValue"/>
                            </VBox>
                            <VBox class="xyraStatChip">
                                <Text text="SOX Compliance Score" class="xyraKpiLabel"/>
                                <Text text="98.4%" class="xyraKpiValue"/>
                            </VBox>
                        </HBox>

                        <!-- POSTURE DONUT + TREND CHART -->
                        <HBox wrap="Wrap" alignItems="Stretch" class="xyraKpiRow sapUiSmallMarginBottom">

                            <VBox width="30%" class="xyraDashboardCard">
                                <Title text="Posture Overview" level="H4" class="sapUiSmallMarginBottom"/>

                                <viz:VizFrame id="postureChart" vizType="donut" width="100%" height="260px" legendVisible="true">
                                    <viz:dataset>
                                        <vizData:FlattenedDataset data="{postureModel>/data}">
                                            <vizData:dimensions>
                                                <vizData:DimensionDefinition name="Status" value="{postureModel>status}"/>
                                            </vizData:dimensions>
                                            <vizData:measures>
                                                <vizData:MeasureDefinition name="Count" value="{postureModel>count}"/>
                                            </vizData:measures>
                                        </vizData:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <vizFeeds:FeedItem uid="size" type="Measure" values="Count"/>
                                        <vizFeeds:FeedItem uid="color" type="Dimension" values="Status"/>
                                    </viz:feeds>
                                </viz:VizFrame>
                            </VBox>

                            <VBox width="68%" class="xyraDashboardCard">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                    <Title text="Trend Overview — Effective Controls" level="H4"/>
                                    <Text text="Last 30 Days" class="textMuted"/>
                                </HBox>

                                <viz:VizFrame id="trendChart" vizType="line" width="100%" height="260px" legendVisible="false">
                                    <viz:dataset>
                                        <vizData:FlattenedDataset data="{trendModel>/data}">
                                            <vizData:dimensions>
                                                <vizData:DimensionDefinition name="Week" value="{trendModel>week}"/>
                                            </vizData:dimensions>
                                            <vizData:measures>
                                                <vizData:MeasureDefinition name="Compliance Score" value="{trendModel>score}"/>
                                            </vizData:measures>
                                        </vizData:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Compliance Score"/>
                                        <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Week"/>
                                    </viz:feeds>
                                </viz:VizFrame>
                            </VBox>

                        </HBox>

                        <!-- RECENT FINDINGS -->
                        <Panel headerText="Recent Findings" expandable="false" class="sapUiSmallMarginBottom">
                            <Table id="recentFindingsTable" items="{findingsModel>/findings}" mode="None">
                                <columns>
                                    <Column width="34%"><Text text="Finding"/></Column>
                                    <Column width="14%"><Text text="Control"/></Column>
                                    <Column width="16%"><Text text="Status"/></Column>
                                    <Column width="12%"><Text text="Severity"/></Column>
                                    <Column width="24%"><Text text="Detected"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{findingsModel>finding}"/>
                                            <Text text="{findingsModel>control}" class="fontWeightBold"/>
                                            <ObjectStatus text="{findingsModel>status}" state="{findingsModel>statusState}"/>
                                            <ObjectStatus text="{findingsModel>severity}" state="{findingsModel>severityState}"/>
                                            <Text text="{findingsModel>detected}" class="textMuted"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar id="_IDGenToolbar">
                        <Text id="_IDGenText3" text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                        <ObjectStatus text="July 30, 2026" icon="sap-icon://appointment-2" state="Information"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>