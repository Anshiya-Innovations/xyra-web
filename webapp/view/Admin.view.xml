<mvc:View
    controllerName="xyraweb.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns:mc="sap.suite.ui.microchart"
    height="100%">

    <tnt:ToolPage id="adminToolPage" sideExpanded="true">

        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="Admin" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList selectedKey="Admin">
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://home" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement"/>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://lightbulb" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://document-text" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="System Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>
                    <tnt:NavigationListItem text="Organization" icon="sap-icon://building" key="Organization" select="onOrganization"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="adminPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <dependents>
                    <ResponsivePopover
                        id="adminProfilePopover"
                        title="Administrator Profile"
                        placement="Bottom"
                        contentWidth="320px"
                        class="xyraProfilePopover">
                        <content>
                            <VBox class="xyraProfilePopoverContent">
                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <Avatar displaySize="M" initials="SA" backgroundColor="Accent6" class="sapUiSmallMarginEnd"/>
                                    <VBox>
                                        <Title text="System Administrator" level="H3"/>
                                        <Text text="Global Administrator"/>
                                        <ObjectStatus text="Online" state="Success"/>
                                    </VBox>
                                </HBox>
                                <VBox class="sapUiSmallMarginBottom">
                                    <Label text="Admin ID" design="Bold"/>
                                    <Text text="ADM001"/>
                                    <Label text="Department" design="Bold"/>
                                    <Text text="Security &amp; Compliance"/>
                                    <Label text="Email" design="Bold"/>
                                    <Text text="admin@xyra.ai"/>
                                    <Label text="Last Login" design="Bold"/>
                                    <Text text="Current Session"/>
                                    <Label text="Theme / Language" design="Bold"/>
                                    <Text text="SAP Horizon / English"/>
                                </VBox>
                                <HBox justifyContent="End" class="sapUiSmallMarginTop">
                                    <Button text="Profile" icon="sap-icon://person-placeholder" type="Transparent" class="sapUiTinyMarginEnd" press="onProfile"/>
                                    <Button text="Logout" icon="sap-icon://log" type="Reject" press="onLogout"/>
                                </HBox>
                            </VBox>
                        </content>
                    </ResponsivePopover>
                </dependents>

                <customHeader>
                    <OverflowToolbar height="4.5rem" class="sapUiSmallMarginBottom">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"/>

                        <VBox justifyContent="Center" class="sapUiTinyMarginBegin">
                            <Title text="Admin Dashboard" level="H4" class="sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>
                        <Button id="_IDGenButton2" icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox id="_IDGenVBox2" width="100%" class="sapUiSmallMargin">

                        <VBox>

                        <!-- PRIMARY KPI CARDS -->
                        <Title text="Compliance Posture" level="H3" class="sapUiSmallMarginBottom"/>

                        <HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="Total Controls" class="textMuted fontSizeSmall fontWeightBold"/>
                                        <Title text="{adminModel>/controlsTotal}" level="H2" class="sapUiTinyMarginTop fontWeightBold"/>
                                    </VBox>
                                    <Avatar src="sap-icon://shield" backgroundColor="Accent6" displaySize="M"/>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                    <ObjectStatus text="{= ${adminModel>/controlsEnabled} + ' Enabled' }" state="Success"/>
                                </HBox>
                            </VBox>

                            <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="Open Deviations" class="textMuted fontSizeSmall fontWeightBold"/>
                                        <Title text="{adminModel>/openDeviations}" level="H2" class="sapUiTinyMarginTop textDanger fontWeightBold"/>
                                    </VBox>
                                    <Avatar src="sap-icon://alert" backgroundColor="Accent1" displaySize="M"/>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                    <ObjectStatus text="{= ${adminModel>/resolvedDeviations} + ' Resolved' }" state="Success"/>
                                </HBox>
                            </VBox>

                            <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="Rule Compliance Rate" class="textMuted fontSizeSmall fontWeightBold"/>
                                        <Title text="{= ${adminModel>/complianceRatePct} + '%' }" level="H2" class="sapUiTinyMarginTop fontWeightBold"/>
                                    </VBox>
                                    <mc:RadialMicroChart
                                        percentage="{adminModel>/complianceRatePct}"
                                        size="XS"
                                        valueColor="{= ${adminModel>/complianceRatePct} >= 80 ? 'Good' : (${adminModel>/complianceRatePct} >= 50 ? 'Critical' : 'Error') }"/>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                    <ObjectStatus text="Rule-check pass rate" state="None"/>
                                </HBox>
                            </VBox>

                            <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="Connected Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                        <Title text="{= ${adminModel>/systemsOnline} + ' / ' + ${adminModel>/systemsTotal} }" level="H2" class="sapUiTinyMarginTop fontWeightBold"/>
                                    </VBox>
                                    <Avatar src="sap-icon://connected" backgroundColor="Accent8" displaySize="M"/>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                    <ObjectStatus text="Online / Total" state="{= ${adminModel>/systemsOnline} === ${adminModel>/systemsTotal} ? 'Success' : 'Warning' }"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- ALERT STATUS BREAKDOWN + REVIEW PIPELINE -->
                        <HBox wrap="Wrap" alignItems="Stretch" class="xyraKpiRow sapUiSmallMarginBottom">

                            <VBox class="xyraDashboardCard xyraDonutCard">
                                <Title text="Alert Status Breakdown" level="H4" class="sapUiSmallMarginBottom"/>
                                <Text text="Open / In Progress / Resolved, across all deviation alerts" class="textMuted sapUiTinyMarginBottom"/>
                                <VBox items="{adminModel>/alertBreakdown}" class="sapUiSmallMarginTop">
                                    <VBox class="xyraProgressRow sapUiTinyMarginBottom">
                                        <HBox justifyContent="SpaceBetween">
                                            <Text text="{adminModel>label}" class="textMuted fontSizeSmall fontWeightBold"/>
                                            <Text text="{adminModel>value}" class="boldText"/>
                                        </HBox>
                                        <!-- class="{binding}" is NOT a live binding in SAPUI5 XML views (verified
                                             against XMLTemplateProcessor.js - it's concatenated as a literal string
                                             at parse time via addStyleClass, never re-evaluated) - so color comes
                                             from 4 static-class variants gated by a real `visible` binding instead. -->
                                        <HBox class="xyraProgressTrack">
                                            <HBox width="{adminModel>pct}" visible="{= ${adminModel>state} === 'Error' }" class="xyraProgressFill xyraProgressFillRed"/>
                                            <HBox width="{adminModel>pct}" visible="{= ${adminModel>state} === 'Warning' }" class="xyraProgressFill xyraProgressFillAmber"/>
                                            <HBox width="{adminModel>pct}" visible="{= ${adminModel>state} === 'Success' }" class="xyraProgressFill xyraProgressFillGreen"/>
                                            <HBox width="{adminModel>pct}" visible="{= ${adminModel>state} === 'None' }" class="xyraProgressFill xyraProgressFillBlue"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <VBox class="xyraDashboardCard xyraTrendCard">
                                <Title text="Review Pipeline" level="H4" class="sapUiSmallMarginBottom"/>
                                <Text text="Where deviations sit in the 2-level review chain right now" class="textMuted sapUiTinyMarginBottom"/>
                                <VBox items="{adminModel>/reviewPipeline}" class="sapUiSmallMarginTop">
                                    <VBox class="xyraProgressRow sapUiTinyMarginBottom">
                                        <HBox justifyContent="SpaceBetween">
                                            <Text text="{adminModel>label}" class="textMuted fontSizeSmall fontWeightBold"/>
                                            <Text text="{adminModel>value}" class="boldText"/>
                                        </HBox>
                                        <HBox class="xyraProgressTrack">
                                            <HBox width="{adminModel>pct}" visible="{= ${adminModel>state} === 'Error' }" class="xyraProgressFill xyraProgressFillRed"/>
                                            <HBox width="{adminModel>pct}" visible="{= ${adminModel>state} === 'Warning' }" class="xyraProgressFill xyraProgressFillAmber"/>
                                            <HBox width="{adminModel>pct}" visible="{= ${adminModel>state} === 'Success' }" class="xyraProgressFill xyraProgressFillGreen"/>
                                            <HBox width="{adminModel>pct}" visible="{= ${adminModel>state} === 'None' }" class="xyraProgressFill xyraProgressFillBlue"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </HBox>

                        <!-- CONTROL HEALTH TABLE (FULL WIDTH) -->
                        <VBox width="100%" class="xyraDashboardCard sapUiSmallMarginBottom">
                            <Title text="Control Health" level="H4" class="sapUiSmallMarginBottom"/>
                            <Text text="Failing or overdue controls surface first" class="textMuted sapUiSmallMarginBottom"/>

                            <Table id="controlHealthTable" items="{adminModel>/controls}" mode="None">
                                <columns>
                                    <Column width="14%"><Text text="Control"/></Column>
                                    <Column width="30%"><Text text="Description"/></Column>
                                    <Column width="12%"><Text text="Frequency"/></Column>
                                    <Column width="12%"><Text text="Enabled"/></Column>
                                    <Column width="12%"><Text text="Last Run"/></Column>
                                    <Column width="20%"><Text text="Next Run"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{adminModel>code}" class="boldText"/>
                                            <Text text="{adminModel>description}"/>
                                            <Text text="{adminModel>frequency}"/>
                                            <ObjectStatus text="{adminModel>enabledText}" state="{adminModel>enabledState}"/>
                                            <ObjectStatus text="{adminModel>lastRunStatus}" state="{adminModel>lastRunState}"/>
                                            <Text text="{adminModel>nextRunAt}" class="textMuted"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                        <!-- RECENT FINDINGS TABLE (FULL WIDTH) -->
                        <VBox width="100%" class="xyraDashboardCard sapUiSmallMarginBottom">
                            <Title text="Recent Findings" level="H4" class="sapUiSmallMarginBottom"/>

                            <Table id="recentFindingsTable" items="{adminModel>/recentFindings}" mode="None">
                                <columns>
                                    <Column width="34%"><Text text="Finding"/></Column>
                                    <Column width="16%"><Text text="Control"/></Column>
                                    <Column width="16%"><Text text="Severity"/></Column>
                                    <Column width="16%"><Text text="Status"/></Column>
                                    <Column width="18%"><Text text="Detected"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{adminModel>finding}" class="boldText"/>
                                            <Text text="{adminModel>control}" class="boldText"/>
                                            <ObjectStatus text="{adminModel>severity}" state="{adminModel>severityState}"/>
                                            <ObjectStatus text="{adminModel>status}" state="{adminModel>statusState}"/>
                                            <Text text="{adminModel>detected}" class="textMuted"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                        </VBox>
                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar id="_IDGenToolbar">
                        <Text id="_IDGenText3" text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                        <ObjectStatus text="July 30, 2026" icon="sap-icon://appointment-2" state="Information"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>