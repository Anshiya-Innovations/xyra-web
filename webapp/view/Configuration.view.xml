<mvc:View
    controllerName="xyraweb.controller.Configuration"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="configToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="Configuration" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList selectedKey="Configuration">
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://home" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement"/>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://lightbulb" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://document-text" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="System Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>
                    <tnt:NavigationListItem text="Organization" icon="sap-icon://building" key="Organization" select="onOrganization"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="configurationPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <dependents>
                    <!-- ADD NEW SYSTEM DIALOG / POPUP -->
                    <Dialog
                        id="addSystemDialog"
                        title="Add New SAP System Configuration"
                        contentWidth="720px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <MessageStrip
                                    text="Fill in SAP System connectivity and environment details below."
                                    type="Information"
                                    showIcon="true"
                                    class="sapUiSmallMarginBottom"/>

                                <Title text="System Identification" level="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>
                                <HBox wrap="Wrap" justifyContent="SpaceBetween">
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="System ID (SID)" required="true" class="xyraLoginLabel"/>
                                        <Input id="newSysId" placeholder="e.g. MY8, MQ8, MP8"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Client" required="true" class="xyraLoginLabel"/>
                                        <Input id="newClient" placeholder="e.g. 100, 000"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="System Type" required="true" class="xyraLoginLabel"/>
                                        <Select id="newSysTypeSelect" width="100%" selectedKey="Quality">
                                            <core:Item key="Development" text="Development"/>
                                            <core:Item key="Quality" text="Quality"/>
                                            <core:Item key="Production" text="Production"/>
                                        </Select>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Host Name" required="true" class="xyraLoginLabel"/>
                                        <Input id="newHostName" placeholder="e.g. asmy800.xyra.com"/>
                                    </VBox>
                                    <VBox width="100%" class="xyraFieldGroup">
                                        <Label text="System Details" class="xyraLoginLabel"/>
                                        <Input id="newSysDetails" placeholder="e.g. EHP4 FOR SAP CRM 7.0"/>
                                    </VBox>
                                </HBox>

                                <Title text="Environment &amp; Network" level="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>
                                <HBox wrap="Wrap" justifyContent="SpaceBetween">
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Sector" class="xyraLoginLabel"/>
                                        <Input id="newSector" value="MedTech" placeholder="e.g. MedTech"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Platform" class="xyraLoginLabel"/>
                                        <Input id="newPlatform" value="USROTC" placeholder="e.g. USROTC"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Region" class="xyraLoginLabel"/>
                                        <Input id="newRegion" value="North America" placeholder="e.g. North America"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Client Type" class="xyraLoginLabel"/>
                                        <Select id="newClientTypeSelect" width="100%" selectedKey="ABAP">
                                            <core:Item key="ABAP" text="ABAP"/>
                                            <core:Item key="JAVA" text="JAVA"/>
                                            <core:Item key="S4/HANA" text="S4/HANA"/>
                                        </Select>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="System Version" class="xyraLoginLabel"/>
                                        <Input id="newSysVersion" value="750" placeholder="e.g. 750, 740"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Logon Group" class="xyraLoginLabel"/>
                                        <Input id="newLogonGroup" value="PUBLIC" placeholder="e.g. PUBLIC"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Port Number" class="xyraLoginLabel"/>
                                        <Input id="newPortNumber" value="3600" placeholder="e.g. 3600"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Instance Number" class="xyraLoginLabel"/>
                                        <Input id="newInstanceNo" value="00" placeholder="e.g. 00"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Save System" type="Emphasized" icon="sap-icon://save" press="onSaveNewSystem"/>
                        </beginButton>
                        <endButton>
                            <Button text="Cancel" press="onCloseAddSystemDialog"/>
                        </endButton>
                    </Dialog>

                    <!-- EDIT SYSTEM DIALOG / POPUP -->
                    <Dialog
                        id="editSystemDialog"
                        title="Edit SAP System Configuration"
                        contentWidth="720px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <MessageStrip
                                    text="Modify SAP System connectivity and environment details."
                                    type="Information"
                                    showIcon="true"
                                    class="sapUiSmallMarginBottom"/>

                                <Title text="System Identification" level="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>
                                <HBox wrap="Wrap" justifyContent="SpaceBetween">
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="System ID (SID)" required="true" class="xyraLoginLabel"/>
                                        <Input id="editSysId" editable="false"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Client" required="true" class="xyraLoginLabel"/>
                                        <Input id="editClient"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="System Type" required="true" class="xyraLoginLabel"/>
                                        <Select id="editSysTypeSelect" width="100%" selectedKey="Quality">
                                            <core:Item key="Development" text="Development"/>
                                            <core:Item key="Quality" text="Quality"/>
                                            <core:Item key="Production" text="Production"/>
                                        </Select>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Host Name" required="true" class="xyraLoginLabel"/>
                                        <Input id="editHostName"/>
                                    </VBox>
                                    <VBox width="100%" class="xyraFieldGroup">
                                        <Label text="System Details" class="xyraLoginLabel"/>
                                        <Input id="editSysDetails"/>
                                    </VBox>
                                </HBox>

                                <Title text="Environment &amp; Network" level="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>
                                <HBox wrap="Wrap" justifyContent="SpaceBetween">
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Sector" class="xyraLoginLabel"/>
                                        <Input id="editSector"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Platform" class="xyraLoginLabel"/>
                                        <Input id="editPlatform"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Region" class="xyraLoginLabel"/>
                                        <Input id="editRegion"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Client Type" class="xyraLoginLabel"/>
                                        <Select id="editClientTypeSelect" width="100%">
                                            <core:Item key="ABAP" text="ABAP"/>
                                            <core:Item key="JAVA" text="JAVA"/>
                                            <core:Item key="S4/HANA" text="S4/HANA"/>
                                        </Select>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="System Version" class="xyraLoginLabel"/>
                                        <Input id="editSysVersion"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Logon Group" class="xyraLoginLabel"/>
                                        <Input id="editLogonGroup"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Port Number" class="xyraLoginLabel"/>
                                        <Input id="editPortNumber"/>
                                    </VBox>
                                    <VBox width="47%" class="xyraFieldGroup">
                                        <Label text="Instance Number" class="xyraLoginLabel"/>
                                        <Input id="editInstanceNo"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Save Changes" type="Emphasized" icon="sap-icon://save" press="onSaveEditedSystem"/>
                        </beginButton>
                        <endButton>
                            <Button text="Cancel" press="onCloseEditSystemDialog"/>
                        </endButton>
                    </Dialog>

                    <!-- SYSTEM HISTORY DIALOG -->
                    <Dialog
                        id="systemHistoryDialog"
                        title="SAP System Landscape Audit History"
                        contentWidth="750px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <Table id="historyTable" items="{historyModel>/entries}">
                                    <columns>
                                        <Column width="25%"><Text text="Timestamp"/></Column>
                                        <Column width="18%"><Text text="Action Type"/></Column>
                                        <Column width="18%"><Text text="System ID"/></Column>
                                        <Column width="20%"><Text text="User"/></Column>
                                        <Column width="19%"><Text text="Status"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{historyModel>timestamp}"/>
                                                <Text text="{historyModel>action}"/>
                                                <Text text="{historyModel>sysId}" class="fontWeightBold"/>
                                                <Text text="{historyModel>user}"/>
                                                <ObjectStatus text="{historyModel>status}" state="{historyModel>statusState}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </content>
                        <endButton>
                            <Button text="Close" press="onCloseSystemHistoryDialog"/>
                        </endButton>
                    </Dialog>
                </dependents>

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <Avatar src="sap-icon://action-settings" displaySize="S" class="sapUiTinyMarginEnd"/>
                        <VBox justifyContent="Center">
                            <Title text="XYRA – SAP System Landscape Configuration" level="H4" class="sapUiNoMargin"/>
                            <Text text="Manage and configure SAP S/4HANA &amp; ERP System Landscape connections." class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- TAB NAVIGATION BUTTONS (SAME AS CONTROL MANAGEMENT) -->
                        <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Button
                                id="btnSystemLandscapeTab"
                                text="System Landscape"
                                icon="sap-icon://chain-link"
                                type="{= ${configUiModel>/activeTab} === 'landscape' ? 'Emphasized' : 'Transparent' }"
                                press="onSelectLandscapeTab"
                                class="sapUiTinyMarginEnd"/>
                            <Button
                                id="btnSystemHealthTab"
                                text="System Health"
                                icon="sap-icon://sys-monitor"
                                type="{= ${configUiModel>/activeTab} === 'systemHealth' ? 'Emphasized' : 'Transparent' }"
                                press="onSelectSystemHealthTab"/>
                        </HBox>

                        <!-- SLIDE 1: SAP SYSTEM LANDSCAPE CONFIGURATION -->
                        <VBox visible="{= ${configUiModel>/activeTab} === 'landscape' }" width="100%">

                            <!-- TOP ACTION BUTTONS BAR -->
                            <HBox justifyContent="End" alignItems="Center" class="sapUiSmallMarginBottom">
                                <SearchField id="searchSystemId" width="16rem" placeholder="Search System ID / Host..." search="onSearchSystems" liveChange="onSearchSystems" class="sapUiSmallMarginEnd"/>
                                <Button text="System History" icon="sap-icon://history" press="onOpenSystemHistory" class="xyraBtnSecondary sapUiSmallMarginEnd"/>
                                <Button text="Add New System" icon="sap-icon://add" type="Emphasized" press="onOpenAddSystemDialog"/>
                            </HBox>

                            <!-- SAP SYSTEMS MASTER LANDSCAPE TABLE -->
                            <Panel expandable="false" class="sapUiSmallMarginBottom">
                                <Table id="systemsTable" items="{systemModel>/systems}" mode="None" width="100%">
                                    <columns>
                                        <Column width="7%"><Text text="System ID"/></Column>
                                        <Column width="5%"><Text text="Client"/></Column>
                                        <Column width="7%"><Text text="System Type"/></Column>
                                        <Column width="11%"><Text text="Host Name"/></Column>
                                        <Column width="17%"><Text text="System Details"/></Column>
                                        <Column width="6%"><Text text="Sector"/></Column>
                                        <Column width="6%"><Text text="Platform"/></Column>
                                        <Column width="8%"><Text text="Region"/></Column>
                                        <Column width="6%"><Text text="Client Type"/></Column>
                                        <Column width="6%"><Text text="System Version"/></Column>
                                        <Column width="6%"><Text text="Logon Group"/></Column>
                                        <Column width="5%"><Text text="Port Number"/></Column>
                                        <Column width="5%"><Text text="Instance N..."/></Column>
                                        <Column width="9%" hAlign="Center"><Text text="Actions"/></Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{systemModel>sysId}" class="fontWeightBold"/>
                                                <Text text="{systemModel>client}"/>
                                                <ObjectStatus text="{systemModel>sysType}" state="{= ${systemModel>sysType} === 'Production' ? 'Error' : (${systemModel>sysType} === 'Quality' ? 'Warning' : 'Information') }"/>
                                                <Text text="{systemModel>hostName}"/>
                                                <Text text="{systemModel>sysDetails}"/>
                                                <Text text="{systemModel>sector}"/>
                                                <Text text="{systemModel>platform}"/>
                                                <Text text="{systemModel>region}"/>
                                                <Text text="{systemModel>clientType}"/>
                                                <Text text="{systemModel>sysVersion}"/>
                                                <Text text="{systemModel>logonGroup}"/>
                                                <Text text="{systemModel>portNumber}"/>
                                                <Text text="{systemModel>instanceNo}"/>
                                                <HBox justifyContent="Center" alignItems="Center">
                                                    <Button icon="sap-icon://edit" type="Emphasized" press="onEditSystem" tooltip="Edit System" class="sapUiTinyMarginEnd"/>
                                                    <Button icon="sap-icon://delete" type="Reject" press="onDeleteSystem" tooltip="Delete System"/>
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Panel>
                        </VBox>

                        <!-- SLIDE 2: SYSTEM HEALTH MONITORING -->
                        <VBox visible="{= ${configUiModel>/activeTab} === 'systemHealth' }" width="100%">

                            <!-- HEADER ACTION CONTROLS BAR -->
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                <VBox>
                                    <Title text="SAP Landscape Live Health &amp; Telemetry" level="H4" class="sapUiNoMargin"/>
                                    <Text text="Real-time availability, connection latency &amp; status monitoring." class="textMuted sapUiNoMargin"/>
                                </VBox>
                                <HBox alignItems="Center">
                                    <Text text="Auto Refresh:" class="sapUiTinyMarginEnd fontWeightBold textMuted"/>
                                    <Switch id="autoRefreshSwitch" state="false" change="onAutoRefreshToggle" customTextOn="ON" customTextOff="OFF" class="sapUiSmallMarginEnd"/>
                                    <Button text="Refresh" icon="sap-icon://refresh" type="Emphasized" press="onRefreshHealth" class="sapUiSmallMarginEnd"/>
                                    <Button text="Test All Connections" icon="sap-icon://connected" press="onTestAllConnections"/>
                                </HBox>
                            </HBox>

                            <!-- HEALTH KPI CARDS SUMMARY BAR -->
                            <HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                <!-- ONLINE SYSTEMS -->
                                <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer" style="background:#f8fafc; border-radius:8px; border-left:4px solid #10b981; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Text text="Online Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                            <Title text="{healthModel>/kpis/online}" level="H2" class="sapUiTinyMarginTop textSuccess fontWeightBold"/>
                                        </VBox>
                                        <Avatar src="sap-icon://sys-enter-2" backgroundColor="Accent8" displaySize="M"/>
                                    </HBox>
                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                        <ObjectStatus text="🟢 Operational" state="Success"/>
                                        <Text text="SLA: 99.98%" class="fontSizeSmall textMuted sapUiTinyMarginBegin"/>
                                    </HBox>
                                </VBox>

                                <!-- OFFLINE SYSTEMS -->
                                <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer" style="background:#f8fafc; border-radius:8px; border-left:4px solid #ef4444; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Text text="Offline Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                            <Title text="{healthModel>/kpis/offline}" level="H2" class="sapUiTinyMarginTop textDanger fontWeightBold"/>
                                        </VBox>
                                        <Avatar src="sap-icon://sys-cancel-2" backgroundColor="Accent1" displaySize="M"/>
                                    </HBox>
                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                        <ObjectStatus text="🔴 Connection Failure" state="Error"/>
                                        <Text text="Alert Active" class="fontSizeSmall textDanger fontWeightBold sapUiTinyMarginBegin"/>
                                    </HBox>
                                </VBox>

                                <!-- DEGRADED SYSTEMS -->
                                <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer" style="background:#f8fafc; border-radius:8px; border-left:4px solid #f59e0b; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Text text="Degraded Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                            <Title text="{healthModel>/kpis/degraded}" level="H2" class="sapUiTinyMarginTop textWarning fontWeightBold"/>
                                        </VBox>
                                        <Avatar src="sap-icon://alert" backgroundColor="Accent3" displaySize="M"/>
                                    </HBox>
                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                        <ObjectStatus text="🟠 High Latency" state="Warning"/>
                                        <Text text="Latency > 120ms" class="fontSizeSmall textWarning sapUiTinyMarginBegin"/>
                                    </HBox>
                                </VBox>

                                <!-- MAINTENANCE SYSTEMS -->
                                <VBox width="23.5%" class="sapUiSmallMarginBottom xyraKpiCardContainer" style="background:#f8fafc; border-radius:8px; border-left:4px solid #3b82f6; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Text text="Maintenance Systems" class="textMuted fontSizeSmall fontWeightBold"/>
                                            <Title text="{healthModel>/kpis/maintenance}" level="H2" class="sapUiTinyMarginTop textPrimary fontWeightBold"/>
                                        </VBox>
                                        <Avatar src="sap-icon://settings" backgroundColor="Accent6" displaySize="M"/>
                                    </HBox>
                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                        <ObjectStatus text="⚙ Scheduled Patch" state="Information"/>
                                        <Text text="Window Active" class="fontSizeSmall textMuted sapUiTinyMarginBegin"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <!-- FILTER BAR -->
                            <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                                <SearchField id="searchHealthSystemId" width="18rem" placeholder="Search System ID / Type..." liveChange="onSearchHealthSystems" search="onSearchHealthSystems" class="sapUiSmallMarginEnd"/>
                                <Text text="Status Filter:" class="sapUiTinyMarginEnd fontWeightBold textMuted"/>
                                <Select id="statusFilterSelect" width="12rem" change="onFilterStatusChange" selectedKey="All">
                                    <core:Item key="All" text="All Statuses"/>
                                    <core:Item key="Online" text="🟢 Online"/>
                                    <core:Item key="Offline" text="🔴 Offline"/>
                                    <core:Item key="Degraded" text="🟠 Degraded"/>
                                    <core:Item key="Maintenance" text="⚙ Maintenance"/>
                                </Select>
                            </HBox>

                            <!-- LIVE SYSTEM HEALTH MONITORING TABLE -->
                            <Panel expandable="false" headerText="SAP Landscape Runtime Health &amp; Availability Matrix" class="sapUiSmallMarginBottom">
                                <Table id="healthTable" items="{healthModel>/systems}" mode="None" width="100%">
                                    <columns>
                                        <Column width="14%"><Text text="System ID" class="fontWeightBold"/></Column>
                                        <Column width="15%"><Text text="System Type"/></Column>
                                        <Column width="10%"><Text text="Client"/></Column>
                                        <Column width="16%"><Text text="Status"/></Column>
                                        <Column width="19%"><Text text="Last Health Check"/></Column>
                                        <Column width="14%"><Text text="Connection Status"/></Column>
                                        <Column width="12%" hAlign="Center"><Text text="Action"/></Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Link text="{healthModel>sysId}" press="onSystemIdPress" class="fontWeightBold fontSizeMedium"/>
                                                <ObjectStatus text="{healthModel>sysType}" state="{= ${healthModel>sysType} === 'Production' ? 'Error' : (${healthModel>sysType} === 'Quality' ? 'Warning' : 'Information') }"/>
                                                <Text text="{healthModel>client}"/>
                                                <ObjectStatus text="{healthModel>status}" state="{healthModel>statusState}" icon="{healthModel>statusIcon}"/>
                                                <Text text="{healthModel>lastCheck}" class="fontSizeSmall textMuted"/>
                                                <Text text="{healthModel>connectionStatus}"/>
                                                <HBox justifyContent="Center" alignItems="Center">
                                                    <Button icon="sap-icon://chain-link" type="Transparent" press="onTestSingleConnection" tooltip="Test RFC Connection" class="sapUiTinyMarginEnd"/>
                                                    <Button icon="sap-icon://slim-arrow-right" type="Emphasized" press="onSystemIdPress" tooltip="View System Health Details"/>
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Panel>
                        </VBox>
                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <Text text="System Landscape Configuration v1.0 | Status: Active"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
