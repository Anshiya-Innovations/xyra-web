                                                            <core:Item key="Equals" text="Equals"/>
                                                            <core:Item key="Not Equals" text="Not Equals"/>
                                                            <core:Item key="Contains" text="Contains"/>
                                                            <core:Item key="Not Contains" text="Not Contains"/>
                                                            <core:Item key="Exists" text="Exists"/>
                                                            <core:Item key="Not Exists" text="Not Exists"/>
                                                            <core:Item key="Greater Than" text="Greater Than"/>
                                                            <core:Item key="Less Than" text="Less Than"/>
                                                            <core:Item key="Greater Than or Equal" text="Greater Than or Equal"/>
                                                            <core:Item key="Less Than or Equal" text="Less Than or Equal"/>
                                                        </Select>

                                                        <VBox width="100%">
                                                            <Input
                                                                value="{ruleModel>expectedValue}"
                                                                type="Number"
                                                                placeholder="Enter number e.g. 3"
                                                                visible="{= ${ruleModel>parameter} === 'Failed Logins' }"
                                                                width="100%"/>
                                                            <Select
                                                                selectedKey="{ruleModel>expectedValue}"
                                                                visible="{= ${ruleModel>parameter} !== 'Failed Logins' }"
                                                                width="100%">
                                                                <core:Item key="" text="-- Select Value --"/>
                                                                <core:Item key="Yes" text="Yes"/>
                                                                <core:Item key="No" text="No"/>
                                                                <core:Item key="A (Dialog User)" text="A (Dialog User)"/>
                                                                <core:Item key="B (System User)" text="B (System User)"/>
