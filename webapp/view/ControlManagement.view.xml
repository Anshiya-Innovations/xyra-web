<mvc:View
    controllerName="xyraweb.controller.ControlManagement"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="controlManagementToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="ControlManagement" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://shield" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement">
                        <tnt:tag>
                            <ObjectStatus text="156 Controls" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://machine" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://business-objects-experience" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="System Health" icon="sap-icon://sys-monitor" key="SystemHealth" select="onSystemHealth"/>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="controlManagementPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <dependents>
                    <!-- CREATE SECURITY CONTROL DIALOG -->
                    <Dialog
                        id="createControlDialog"
                        title="Create Security Control Master"
                        contentWidth="620px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <Label text="Control ID" required="true"/>
                                <Input id="createControlIdInput" placeholder="e.g. XYRA-08, XYRA-28, XYRA-001" class="sapUiSmallMarginBottom"/>

                                <Label text="Control Description" required="true"/>
                                <TextArea id="createControlDescInput" rows="3" width="100%" placeholder="Enter detailed security control description..." class="sapUiSmallMarginBottom"/>

                                <Label text="System Type" required="true"/>
                                <Select id="createSysType1Select" selectedKey="DEV" width="100%" change="onSysTypeChange" class="sapUiSmallMarginBottom">
                                    <core:Item key="DEV" text="DEV"/>
                                    <core:Item key="QAS" text="QAS"/>
                                    <core:Item key="PRD" text="PRD"/>
                                </Select>

                                <Label text="System Type"/>
                                <Select id="createSysType2Select" selectedKey="None" width="100%" change="onSysTypeChange" class="sapUiSmallMarginBottom">
                                    <core:Item key="None" text="-- None --"/>
                                    <core:Item key="DEV" text="DEV"/>
                                    <core:Item key="QAS" text="QAS"/>
                                    <core:Item key="PRD" text="PRD"/>
                                </Select>

                                <Label text="System Type"/>
                                <Select id="createSysType3Select" selectedKey="None" width="100%" change="onSysTypeChange" class="sapUiSmallMarginBottom">
                                    <core:Item key="None" text="-- None --"/>
                                    <core:Item key="DEV" text="DEV"/>
                                    <core:Item key="QAS" text="QAS"/>
                                    <core:Item key="PRD" text="PRD"/>
                                </Select>

                                <Label text="Frequency Run" required="true"/>
                                <Select id="createFrequencySelect" selectedKey="Daily" width="100%" change="onCreateFrequencyChange" class="sapUiSmallMarginBottom">
                                    <core:Item key="Monthly (Last day of month)" text="Monthly (Last day of month)"/>
                                    <core:Item key="Weekly (Every Monday)" text="Weekly (Every Monday)"/>
                                    <core:Item key="Daily" text="Daily"/>
                                    <core:Item key="Realtime" text="Realtime"/>
                                    <core:Item key="Cron Expression" text="Cron Expression"/>
                                </Select>

                                <VBox id="vboxCreateCron" visible="false" class="sapUiSmallMarginBottom">
                                    <Label text="Cron Expression" required="true"/>
                                    <Input id="createCronInput" placeholder="e.g. 0 0 1 * *" liveChange="onCronInputChange" class="sapUiTinyMarginBottom"/>
                                    <MessageStrip
                                        text="Examples: '* * * * *' (Realtime) | '0 0 * * *' (Daily) | '0 0 * * 1' (Weekly - Every Monday) | '0 0 L * *' (Monthly - Last day of month)"
                                        type="Information"
                                        showIcon="true"/>
                                </VBox>

                                <Label text="Total Run (Read-Only)"/>
                                <Input id="createTotalRunInput" value="365" editable="false" class="sapUiSmallMarginBottom"/>

                                <!-- RULE BUILDER SECTION -->
                                <Panel expandable="true" expanded="true" class="sapUiSmallMarginTop">
                                    <headerToolbar>
                                        <OverflowToolbar style="Clear">
                                            <Title text="Rule Configuration" level="H6"/>
                                            <ToolbarSpacer/>
                                            <Button text="Add Rule" icon="sap-icon://add" type="Emphasized" press="onAddCreateRule"/>
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <content>
                                        <VBox items="{ruleModel>/createRules}">
                                            <items>
                                                <VBox class="sapUiSmallMarginBottom sapUiSmallPadding">
                                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                                                        <Title text="{ruleModel>stepLabel}" level="H6"/>
                                                        <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete Rule" press="onDeleteCreateRule"/>
                                                    </HBox>
                                                    <layout:Grid defaultSpan="L4 M4 S12" class="sapUiNoMargin">
                                                        <VBox>
                                                            <Label text="Parameter" required="true"/>
                                                            <Select selectedKey="{ruleModel>parameter}" width="100%">
                                                                <core:Item key="" text="-- Select Parameter --"/>
                                                                <core:Item key="Password Changed" text="Password Changed"/>
                                                                <core:Item key="User Type" text="User Type"/>
                                                                <core:Item key="Locked" text="Locked"/>
                                                                <core:Item key="Failed Logins" text="Failed Logins"/>
                                                                <core:Item key="Roles Assigned" text="Roles Assigned"/>
                                                                <core:Item key="Security Policy" text="Security Policy"/>
                                                                <core:Item key="SDMI_* Exists" text="SDMI_* Exists"/>
                                                            </Select>
                                                        </VBox>
                                                        <VBox>
                                                            <Label text="Operator" required="true"/>
                                                            <Select selectedKey="{ruleModel>operator}" width="100%">
                                                                <core:Item key="" text="-- Select Operator --"/>
                                                                <core:Item key="Equals" text="Equals"/>
                                                                <core:Item key="Not Equals" text="Not Equals"/>
                                                                <core:Item key="Greater Than" text="Greater Than"/>
                                                                <core:Item key="Less Than" text="Less Than"/>
                                                                <core:Item key="Contains" text="Contains"/>
                                                            </Select>
                                                        </VBox>
                                                        <VBox>
                                                            <Label text="Expected Value" required="true"/>
                                                            <ComboBox value="{ruleModel>expectedValue}" placeholder="Select or Enter Expected Value..." width="100%">
                                                                <core:Item key="" text="-- Select Expected Value --"/>
                                                                <core:Item key="True" text="True"/>
                                                                <core:Item key="False" text="False"/>
                                                                <core:Item key="B" text="B"/>
                                                                <core:Item key="A" text="A"/>
                                                                <core:Item key="Enabled" text="Enabled"/>
                                                                <core:Item key="Disabled" text="Disabled"/>
                                                            </ComboBox>
                                                        </VBox>
                                                    </layout:Grid>
                                                </VBox>
                                            </items>
                                        </VBox>
                                        <HBox justifyContent="Center" class="sapUiTinyMarginTop">
                                            <Button text="+ Add Rule" type="Ghost" icon="sap-icon://add" press="onAddCreateRule"/>
                                        </HBox>
                                    </content>
                                </Panel>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Save" type="Emphasized" icon="sap-icon://save" press="onSubmitCreateControl"/>
                        </beginButton>
                        <endButton>
                            <Button text="Cancel" press="onCloseCreateControlDialog"/>
                        </endButton>
                    </Dialog>

                    <!-- EDIT SECURITY CONTROL DIALOG -->
                    <Dialog
                        id="editControlDialog"
                        title="Edit Security Control Master"
                        contentWidth="620px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <Label text="Control ID"/>
                                <Input id="editControlIdInput" editable="false" class="sapUiSmallMarginBottom"/>

                                <Label text="Control Description" required="true"/>
                                <TextArea id="editControlDescInput" rows="3" width="100%" class="sapUiSmallMarginBottom"/>

                                <Label text="System Type" required="true"/>
                                <Select id="editSysType1Select" width="100%" change="onSysTypeChange" class="sapUiSmallMarginBottom">
                                    <core:Item key="DEV" text="DEV"/>
                                    <core:Item key="QAS" text="QAS"/>
                                    <core:Item key="PRD" text="PRD"/>
                                </Select>

                                <Label text="System Type"/>
                                <Select id="editSysType2Select" width="100%" change="onSysTypeChange" class="sapUiSmallMarginBottom">
                                    <core:Item key="None" text="-- None --"/>
                                    <core:Item key="DEV" text="DEV"/>
                                    <core:Item key="QAS" text="QAS"/>
                                    <core:Item key="PRD" text="PRD"/>
                                </Select>

                                <Label text="System Type"/>
                                <Select id="editSysType3Select" width="100%" change="onSysTypeChange" class="sapUiSmallMarginBottom">
                                    <core:Item key="None" text="-- None --"/>
                                    <core:Item key="DEV" text="DEV"/>
                                    <core:Item key="QAS" text="QAS"/>
                                    <core:Item key="PRD" text="PRD"/>
                                </Select>

                                <Label text="Frequency Run" required="true"/>
                                <Select id="editFrequencySelect" width="100%" change="onEditFrequencyChange" class="sapUiSmallMarginBottom">
                                    <core:Item key="Monthly (Last day of month)" text="Monthly (Last day of month)"/>
                                    <core:Item key="Weekly (Every Monday)" text="Weekly (Every Monday)"/>
                                    <core:Item key="Daily" text="Daily"/>
                                    <core:Item key="Realtime" text="Realtime"/>
                                    <core:Item key="Cron Expression" text="Cron Expression"/>
                                </Select>

                                <VBox id="vboxEditCron" visible="false" class="sapUiSmallMarginBottom">
                                    <Label text="Cron Expression" required="true"/>
                                    <Input id="editCronInput" placeholder="e.g. 0 0 1 * *" liveChange="onCronInputChange" class="sapUiTinyMarginBottom"/>
                                    <MessageStrip
                                        text="Examples: '* * * * *' (Realtime) | '0 0 * * *' (Daily) | '0 0 * * 1' (Weekly - Every Monday) | '0 0 L * *' (Monthly - Last day of month)"
                                        type="Information"
                                        showIcon="true"/>
                                </VBox>

                                <Label text="Total Run (Read-Only)"/>
                                <Input id="editTotalRunInput" editable="false" class="sapUiSmallMarginBottom"/>

                                <!-- RULE BUILDER SECTION -->
                                <Panel expandable="true" expanded="true" class="sapUiSmallMarginTop">
                                    <headerToolbar>
                                        <OverflowToolbar style="Clear">
                                            <Title text="Rule Configuration" level="H6"/>
                                            <ToolbarSpacer/>
                                            <Button text="Add Rule" icon="sap-icon://add" type="Emphasized" press="onAddEditRule"/>
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <content>
                                        <VBox items="{ruleModel>/editRules}">
                                            <items>
                                                <VBox class="sapUiSmallMarginBottom sapUiSmallPadding">
                                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                                                        <Title text="{ruleModel>stepLabel}" level="H6"/>
                                                        <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete Rule" press="onDeleteEditRule"/>
                                                    </HBox>
                                                    <layout:Grid defaultSpan="L4 M4 S12" class="sapUiNoMargin">
                                                        <VBox>
                                                            <Label text="Parameter" required="true"/>
                                                            <Select selectedKey="{ruleModel>parameter}" width="100%">
                                                                <core:Item key="" text="-- Select Parameter --"/>
                                                                <core:Item key="Password Changed" text="Password Changed"/>
                                                                <core:Item key="User Type" text="User Type"/>
                                                                <core:Item key="Locked" text="Locked"/>
                                                                <core:Item key="Failed Logins" text="Failed Logins"/>
                                                                <core:Item key="Roles Assigned" text="Roles Assigned"/>
                                                                <core:Item key="Security Policy" text="Security Policy"/>
                                                                <core:Item key="SDMI_* Exists" text="SDMI_* Exists"/>
                                                            </Select>
                                                        </VBox>
                                                        <VBox>
                                                            <Label text="Operator" required="true"/>
                                                            <Select selectedKey="{ruleModel>operator}" width="100%">
                                                                <core:Item key="" text="-- Select Operator --"/>
                                                                <core:Item key="Equals" text="Equals"/>
                                                                <core:Item key="Not Equals" text="Not Equals"/>
                                                                <core:Item key="Greater Than" text="Greater Than"/>
                                                                <core:Item key="Less Than" text="Less Than"/>
                                                                <core:Item key="Contains" text="Contains"/>
                                                            </Select>
                                                        </VBox>
                                                        <VBox>
                                                            <Label text="Expected Value" required="true"/>
                                                            <ComboBox value="{ruleModel>expectedValue}" placeholder="Select or Enter Expected Value..." width="100%">
                                                                <core:Item key="" text="-- Select Expected Value --"/>
                                                                <core:Item key="True" text="True"/>
                                                                <core:Item key="False" text="False"/>
                                                                <core:Item key="B" text="B"/>
                                                                <core:Item key="A" text="A"/>
                                                                <core:Item key="Enabled" text="Enabled"/>
                                                                <core:Item key="Disabled" text="Disabled"/>
                                                            </ComboBox>
                                                        </VBox>
                                                    </layout:Grid>
                                                </VBox>
                                            </items>
                                        </VBox>
                                        <HBox justifyContent="Center" class="sapUiTinyMarginTop">
                                            <Button text="+ Add Rule" type="Ghost" icon="sap-icon://add" press="onAddEditRule"/>
                                        </HBox>
                                    </content>
                                </Panel>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Save" type="Emphasized" icon="sap-icon://save" press="onSubmitEditControl"/>
                        </beginButton>
                        <endButton>
                            <Button text="Cancel" press="onCloseEditControlDialog"/>
                        </endButton>
                    </Dialog>
                </dependents>

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <Avatar initials="CM" displaySize="S" backgroundColor="Accent8" class="sapUiTinyMarginEnd"/>
                        <VBox justifyContent="Center">
                            <Title text="🛡️ Control Management" level="H4" class="sapUiNoMargin"/>
                            <Text text="Configure Security Control Rules, Target Environments (DEV/QAS/PRD), and Execution Frequencies." class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Admin Dashboard" type="Transparent" press="onAdmin" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- TAB NAVIGATION BUTTONS -->
                        <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Button text="Control Management" icon="sap-icon://shield" type="Emphasized" class="sapUiTinyMarginEnd"/>
                            <Button text="Automation Monitoring" icon="sap-icon://sys-monitor" type="Transparent" press="onNavAutomationMonitoring"/>
                        </HBox>

                        <!-- SECURITY CONTROL MASTER TABLE -->
                        <Panel expandable="false" class="sapUiSmallMarginBottom">
                            <Table id="controlsTable" items="{controlsModel>/controls}" mode="None" width="100%">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Security Control Master Directory" level="H3"/>
                                        <ToolbarSpacer/>
                                        
                                        <!-- SEARCH CONTROL ID -->
                                        <SearchField
                                            id="searchControlId"
                                            width="16rem"
                                            placeholder="Search Control ID..."
                                            search="onSearchControls"
                                            liveChange="onSearchControls"/>

                                        <!-- + CREATE SECURITY CONTROL BUTTON -->
                                        <Button text="Create Security Control" icon="sap-icon://add" type="Emphasized" press="onCreateControl"/>
                                    </OverflowToolbar>
                                </headerToolbar>

                                <!-- TABLE COLUMNS: HEADERS SAY "System Type" WITHOUT NUMBERS -->
                                <columns>
                                    <Column width="12%"><Text text="Control ID"/></Column>
                                    <Column width="24%"><Text text="Control Description"/></Column>
                                    <Column width="9%"><Text text="System Type"/></Column>
                                    <Column width="9%"><Text text="System Type"/></Column>
                                    <Column width="9%"><Text text="System Type"/></Column>
                                    <Column width="20%"><Text text="Frequency Run"/></Column>
                                    <Column width="10%"><Text text="Total Run"/></Column>
                                    <Column width="7%" hAlign="End"><Text text="Actions"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{controlsModel>id}"/>
                                            <Text text="{controlsModel>description}"/>

                                            <ObjectStatus text="{controlsModel>sysType1}" state="Information"/>
                                            <ObjectStatus text="{controlsModel>sysType2}" state="{= ${controlsModel>sysType2} === 'None' ? 'None' : 'Information' }"/>
                                            <ObjectStatus text="{controlsModel>sysType3}" state="{= ${controlsModel>sysType3} === 'None' ? 'None' : 'Information' }"/>
                                            <Text text="{controlsModel>frequencyRun}" wrapping="false"/>

                                            <ObjectStatus text="{controlsModel>totalRun}" state="Success"/>
                                            <HBox justifyContent="End">
                                                <Button icon="sap-icon://edit" type="Transparent" press="onEditControl" tooltip="Edit Security Control"/>
                                                <Button icon="sap-icon://delete" type="Transparent" press="onDeleteControl" tooltip="Delete Security Control"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <Text text="Control Management v1.0 | Status: Active"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
