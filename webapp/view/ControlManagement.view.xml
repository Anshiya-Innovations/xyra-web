<mvc:View
    controllerName="xyraweb.controller.ControlManagement"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="controlManagementToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="ControlManagement" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList selectedKey="ControlManagement">
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://home" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" expanded="true" selectable="false">
                        <tnt:NavigationListItem text="Controls Config" key="ControlManagement" select="onControlManagement"/>
                        <tnt:NavigationListItem text="Deviation Report" key="DeviationReport" select="onDeviationReport"/>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://lightbulb" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://document-text" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="System Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>
                    <tnt:NavigationListItem text="Organization" icon="sap-icon://building" key="Organization" select="onOrganization"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="controlManagementPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">


                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <VBox justifyContent="Center">
                            <Title text="Control Management" level="H4" class="sapUiNoMargin"/>
                            <Text text="Configure Security Control Rules, Target Environments (DEV/QAS/PRD), and Execution Frequencies." class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Admin Dashboard" type="Transparent" press="onAdmin" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- SECURITY CONTROL MASTER TABLE -->
                        <Panel expandable="false" class="sapUiSmallMarginBottom">
                            <Table id="controlsTable" items="{controlsModel>/controls}" mode="None" width="100%">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Security Control Master Directory" level="H3"/>
                                        <ToolbarSpacer/>
                                        
                                        <!-- SEARCH CONTROL ID -->
                                        <SearchField
                                            id="searchControlId"
                                            width="16rem"
                                            placeholder="Search Control ID..."
                                            search="onSearchControls"
                                            liveChange="onSearchControls"/>

                                        <!-- + CREATE SECURITY CONTROL BUTTON -->
                                        <Button text="Create Security Control" icon="sap-icon://add" type="Emphasized" press="onCreateControl"/>
                                    </OverflowToolbar>
                                </headerToolbar>

                                <!-- TABLE COLUMNS: HEADERS SAY "System Type" WITHOUT NUMBERS -->
                                <columns>
                                    <Column width="12%"><Text text="Control ID"/></Column>
                                    <Column width="24%"><Text text="Control Description"/></Column>
                                    <Column width="9%"><Text text="System Type"/></Column>
                                    <Column width="9%"><Text text="System Type"/></Column>
                                    <Column width="9%"><Text text="System Type"/></Column>
                                    <Column width="20%"><Text text="Frequency Run"/></Column>
                                    <Column width="10%"><Text text="Total Run"/></Column>
                                    <Column width="7%" hAlign="End"><Text text="Actions"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{controlsModel>id}"/>
                                            <Text text="{controlsModel>description}"/>

                                            <ObjectStatus text="{controlsModel>sysType1}" state="Information"/>
                                            <ObjectStatus text="{controlsModel>sysType2}" state="{= ${controlsModel>sysType2} === 'None' ? 'None' : 'Information' }"/>
                                            <ObjectStatus text="{controlsModel>sysType3}" state="{= ${controlsModel>sysType3} === 'None' ? 'None' : 'Information' }"/>
                                            <Text text="{controlsModel>frequencyRun}" wrapping="false"/>

                                            <ObjectStatus text="{controlsModel>totalRun}" state="Success"/>
                                            <HBox justifyContent="End" style="gap: 0.5rem;">
                                                <Button icon="sap-icon://play" type="Transparent" press="onRunControlNow" tooltip="Run Now"/>
                                                <Button icon="sap-icon://edit" type="Emphasized" press="onEditControl" tooltip="Edit Security Control"/>
                                                <Button icon="sap-icon://delete" type="Reject" press="onDeleteControl" tooltip="Delete Security Control"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <ObjectStatus text="July 30, 2026" icon="sap-icon://appointment-2" state="Information"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
