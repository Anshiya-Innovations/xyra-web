<mvc:View
    controllerName="xyraweb.controller.RoleReview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="roleReviewToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="RoleManagement" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://shield" key="Admin" select="onAdmin"/>


                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement">
                        <tnt:tag>
                            <ObjectStatus text="156 Controls" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://machine" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://business-objects-experience" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="System Health" icon="sap-icon://sys-monitor" key="SystemHealth" select="onSystemHealth"/>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="roleReviewPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <Avatar initials="RR" displaySize="S" backgroundColor="Accent4" class="sapUiTinyMarginEnd"/>
                        <VBox justifyContent="Center">
                            <Title text="🔍 XYRA – Role Review" level="H4" class="sapUiNoMargin"/>
                            <Text text="Automated monthly review of manual role changes extracted from production systems and validated against SCS Standards." class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Admin Dashboard" type="Transparent" press="onAdmin" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- NAVIGATION BUTTONS -->
                        <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Button text="Role Review" icon="sap-icon://history" type="Emphasized"/>
                        </HBox>

                        <!-- KPI SUMMARY CARDS (4 CARDS) -->
                        <layout:Grid defaultSpan="XL3 L3 M6 S12" class="sapUiNoMargin">

                            <f:Card class="sapUiTinyMarginBottom">
                                <f:header>
                                    <card:Header
                                        title="1,248"
                                        subtitle="Total Roles Reviewed"
                                        iconSrc="sap-icon://role"
                                        statusText="Monthly Audit"/>
                                </f:header>
                            </f:Card>

                            <f:Card class="sapUiTinyMarginBottom">
                                <f:header>
                                    <card:Header
                                        title="42"
                                        subtitle="Changed Roles"
                                        iconSrc="sap-icon://edit"
                                        statusText="Manual Changes"/>
                                </f:header>
                            </f:Card>

                            <f:Card class="sapUiTinyMarginBottom">
                                <f:header>
                                    <card:Header
                                        title="6"
                                        subtitle="Deviations"
                                        iconSrc="sap-icon://alert"
                                        statusText="SCS Violations"/>
                                </f:header>
                            </f:Card>

                            <f:Card class="sapUiTinyMarginBottom">
                                <f:header>
                                    <card:Header
                                        title="3"
                                        subtitle="Pending Reviews"
                                        iconSrc="sap-icon://pending"
                                        statusText="Action Required"/>
                                </f:header>
                            </f:Card>

                        </layout:Grid>

                        <!-- MESSAGE STRIP & REVIEW INFORMATION -->
                        <VBox class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                            <MessageStrip
                                text="SCS Automated Validation: 6 manual role modifications detected for Review Period 'July 2026'. Deviations require mandatory reviewer sign-off prior to SCS compliance lock."
                                type="Warning"
                                showIcon="true"
                                class="sapUiTinyMarginBottom"/>

                            <f:Card>
                                <f:header>
                                    <card:Header
                                        title="Monthly Review Context Information"
                                        subtitle="SCS Automation Engine &amp; Production Target Parameters"
                                        iconSrc="sap-icon://sys-monitor"/>
                                </f:header>
                                <f:content>
                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMargin">
                                        <VBox>
                                            <Label text="Review Period" class="textMuted"/>
                                            <Title text="July 2026 (01-Jul to 31-Jul)" level="H5"/>
                                        </VBox>
                                        <VBox>
                                            <Label text="System" class="textMuted"/>
                                            <Title text="PRD-100 (S/4HANA Enterprise)" level="H5"/>
                                        </VBox>
                                        <VBox>
                                            <Label text="Client" class="textMuted"/>
                                            <Title text="Client 100" level="H5"/>
                                        </VBox>
                                        <VBox>
                                            <Label text="Automation Extractor" class="textMuted"/>
                                            <Title text="XYRA SCS Job Engine v2.4" level="H5"/>
                                        </VBox>
                                        <VBox>
                                            <Label text="Last Scan Date" class="textMuted"/>
                                            <Title text="31-Jul-2026 18:30 IST" level="H5"/>
                                        </VBox>
                                    </HBox>
                                </f:content>
                            </f:Card>
                        </VBox>

                        <!-- RESPONSIVE SAP TABLE: ROLE REVIEW & DEVIATION ANALYSIS -->
                        <Panel expandable="false" class="sapUiSmallMarginTop">
                            <Table id="roleReviewTable" items="{reviewModel>/reviews}" mode="None" width="100%">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Automated Monthly Role Changes &amp; SCS Deviations" level="H3"/>
                                        <ToolbarSpacer/>
                                        <SearchField width="16rem" placeholder="Search role ID, changed by..." search="onSearchReviews"/>
                                        <Button text="Approve All" icon="sap-icon://accept" type="Success" press="onApproveSelected" class="sapUiTinyMarginEnd"/>
                                        <Button text="Reject Changes" icon="sap-icon://decline" type="Reject" press="onRejectSelected" class="sapUiTinyMarginEnd"/>
                                        <Button text="Request Info" icon="sap-icon://hint" type="Attention" press="onRequestInfo" class="sapUiTinyMarginEnd"/>
                                        <Button text="Export SCS Report" icon="sap-icon://excel-attachment" type="Ghost" press="onExportReport"/>
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column width="14%"><Text text="Role ID"/></Column>
                                    <Column width="20%"><Text text="Role Name"/></Column>
                                    <Column width="14%"><Text text="Changed By"/></Column>
                                    <Column width="10%"><Text text="Change Date"/></Column>
                                    <Column width="16%"><Text text="Deviation"/></Column>
                                    <Column width="10%"><Text text="SCS Status"/></Column>
                                    <Column width="8%"><Text text="Risk"/></Column>
                                    <Column width="8%"><Text text="Reviewer Status"/></Column>
                                    <Column width="10%" hAlign="Center"><Text text="Action"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{reviewModel>roleId}"/>
                                            <Text text="{reviewModel>roleName}"/>
                                            <Text text="{reviewModel>changedBy}"/>
                                            <Text text="{reviewModel>changeDate}"/>
                                            <Text text="{reviewModel>deviation}"/>
                                            <ObjectStatus text="{reviewModel>scsStatus}" state="{reviewModel>scsState}"/>
                                            <ObjectStatus text="{reviewModel>risk}" state="{reviewModel>riskState}"/>
                                            <ObjectStatus text="{reviewModel>reviewerStatus}" state="{reviewModel>reviewerState}"/>
                                            <HBox justifyContent="Center" alignItems="Center">
                                                <Button icon="sap-icon://accept" type="Accept" tooltip="Approve" press="onApproveItem" class="sapUiTinyMarginEnd" enabled="{= ${reviewModel>reviewerStatus} === 'Pending' }"/>
                                                <Button icon="sap-icon://decline" type="Reject" tooltip="Reject" press="onRejectItem" enabled="{= ${reviewModel>reviewerStatus} === 'Pending' }"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <Text text="Version 1.0 | Status: Active"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
