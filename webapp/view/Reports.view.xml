<mvc:View
    controllerName="xyraweb.controller.Reports"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="reportsToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="Reports" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList selectedKey="Reports">
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://home" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement"/>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://lightbulb" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://document-text" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="System Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>
                    <tnt:NavigationListItem text="Organization" icon="sap-icon://building" key="Organization" select="onOrganization"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="reportsPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <VBox justifyContent="Center">
                            <Title text="XYRA – Reports" level="H4" class="sapUiNoMargin"/>
                            <Text text="Control History Data Review" class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Admin Dashboard" type="Transparent" press="onAdmin" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- FILTER CRITERIA -->
                        <Panel expandable="false" class="sapUiSmallMarginBottom">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="Control History Data Review" level="H4"/>
                                    <ToolbarSpacer/>
                                    <Button text="Generate History" type="Emphasized" icon="sap-icon://history" press="onGenerateHistory" class="sapUiTinyMarginEnd"/>
                                    <Button text="Export CSV" type="Default" icon="sap-icon://document" press="onExportCsv"/>
                                </OverflowToolbar>
                            </headerToolbar>
                            <content>
                                <HBox wrap="Wrap" justifyContent="SpaceBetween" alignItems="Start">
                                    <VBox width="15.8%" class="xyraFieldGroup">
                                        <Label text="Control" required="true" class="xyraLoginLabel"/>
                                        <Select
                                            id="filterControl"
                                            selectedKey="{reportModel>/filters/controlId}"
                                            width="100%"
                                            items="{reportFilterOptionsModel>/controls}">
                                            <core:Item key="{reportFilterOptionsModel>key}" text="{reportFilterOptionsModel>text}"/>
                                        </Select>
                                    </VBox>

                                    <VBox width="15.8%" class="xyraFieldGroup">
                                        <Label text="System" class="xyraLoginLabel"/>
                                        <Select
                                            id="filterHistorySystem"
                                            selectedKey="{reportModel>/filters/systemId}"
                                            width="100%"
                                            items="{reportFilterOptionsModel>/systems}">
                                            <core:Item key="{reportFilterOptionsModel>key}" text="{reportFilterOptionsModel>text}"/>
                                        </Select>
                                    </VBox>

                                    <VBox width="15.8%" class="xyraFieldGroup">
                                        <Label text="Client" class="xyraLoginLabel"/>
                                        <Select
                                            id="filterHistoryClient"
                                            selectedKey="{reportModel>/filters/client}"
                                            width="100%"
                                            items="{reportFilterOptionsModel>/clients}">
                                            <core:Item key="{reportFilterOptionsModel>key}" text="{reportFilterOptionsModel>text}"/>
                                        </Select>
                                    </VBox>

                                    <VBox width="15.8%" class="xyraFieldGroup">
                                        <Label text="Region" class="xyraLoginLabel"/>
                                        <Select
                                            id="filterHistoryRegion"
                                            selectedKey="{reportModel>/filters/region}"
                                            width="100%"
                                            items="{reportFilterOptionsModel>/regions}">
                                            <core:Item key="{reportFilterOptionsModel>key}" text="{reportFilterOptionsModel>text}"/>
                                        </Select>
                                    </VBox>

                                    <VBox width="15.8%" class="xyraFieldGroup">
                                        <Label text="Platform" class="xyraLoginLabel"/>
                                        <Select
                                            id="filterHistoryPlatform"
                                            selectedKey="{reportModel>/filters/platform}"
                                            width="100%"
                                            items="{reportFilterOptionsModel>/platforms}">
                                            <core:Item key="{reportFilterOptionsModel>key}" text="{reportFilterOptionsModel>text}"/>
                                        </Select>
                                    </VBox>

                                    <VBox width="15.8%" class="xyraFieldGroup">
                                        <Label text="Sector" class="xyraLoginLabel"/>
                                        <Select
                                            id="filterHistorySector"
                                            selectedKey="{reportModel>/filters/sector}"
                                            width="100%"
                                            items="{reportFilterOptionsModel>/sectors}">
                                            <core:Item key="{reportFilterOptionsModel>key}" text="{reportFilterOptionsModel>text}"/>
                                        </Select>
                                    </VBox>

                                    <VBox width="15.8%" class="xyraFieldGroup">
                                        <Label text="Start Date" class="xyraLoginLabel"/>
                                        <DatePicker id="historyStartDate" width="100%" placeholder="Select Start Date"/>
                                    </VBox>

                                    <VBox width="15.8%" class="xyraFieldGroup">
                                        <Label text="End Date" class="xyraLoginLabel"/>
                                        <DatePicker id="historyEndDate" width="100%" placeholder="Select End Date"/>
                                    </VBox>
                                </HBox>
                            </content>
                        </Panel>

                        <!-- EVIDENCE SUMMARY - the whole point of this page vs. Deviation
                             Report: every value the control ever examined, pass or fail,
                             not just the ones that became incidents. -->
                        <HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <VBox width="32%" class="sapUiSmallMarginBottom xyraKpiCardContainer">
                                <Text text="Total Values Extracted" class="textMuted fontSizeSmall fontWeightBold"/>
                                <ObjectNumber number="{reportModel>/summary/total}" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox width="32%" class="sapUiSmallMarginBottom xyraKpiCardContainer">
                                <Text text="Passed (No Deviation)" class="textMuted fontSizeSmall fontWeightBold"/>
                                <ObjectNumber number="{reportModel>/summary/passed}" state="Success" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox width="32%" class="sapUiSmallMarginBottom xyraKpiCardContainer">
                                <Text text="Deviations Found" class="textMuted fontSizeSmall fontWeightBold"/>
                                <ObjectNumber number="{reportModel>/summary/deviations}" state="Error" class="sapUiTinyMarginTop"/>
                            </VBox>
                        </HBox>

                        <!-- CONTROL RUN HISTORY TABLE -->
                        <Panel expandable="false" class="sapUiSmallMarginBottom">
                            <Table id="controlHistoryTable" items="{reportModel>/rows}" mode="None" width="100%" noDataText="Select a Control and press Generate History to see extracted values.">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Extracted Control Run Values" level="H3"/>
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column width="9%"><Text text="Control ID"/></Column>
                                    <Column width="16%"><Text text="Description"/></Column>
                                    <Column width="7%"><Text text="System"/></Column>
                                    <Column width="6%"><Text text="Client"/></Column>
                                    <Column width="7%"><Text text="Region"/></Column>
                                    <Column width="7%"><Text text="Platform"/></Column>
                                    <Column width="7%"><Text text="Sector"/></Column>
                                    <Column width="9%"><Text text="SAP Object"/></Column>
                                    <Column width="9%"><Text text="Parameter"/></Column>
                                    <Column width="7%"><Text text="Actual"/></Column>
                                    <Column width="7%"><Text text="Expected"/></Column>
                                    <Column width="6%"><Text text="Status"/></Column>
                                    <Column width="10%"><Text text="Captured At"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{reportModel>controlId}"/>
                                            <Text text="{reportModel>controlDescription}"/>
                                            <Text text="{reportModel>systemId}"/>
                                            <Text text="{reportModel>client}"/>
                                            <Text text="{reportModel>region}"/>
                                            <Text text="{reportModel>platform}"/>
                                            <Text text="{reportModel>sector}"/>
                                            <Text text="{reportModel>sapObject}"/>
                                            <Text text="{reportModel>parameter}"/>
                                            <Text text="{reportModel>actualValue}"/>
                                            <Text text="{reportModel>expectedValue}"/>
                                            <ObjectStatus text="{reportModel>deviationText}" state="{reportModel>deviationState}"/>
                                            <Text text="{reportModel>capturedAt}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
