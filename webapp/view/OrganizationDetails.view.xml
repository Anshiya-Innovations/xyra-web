<mvc:View
    controllerName="xyraweb.controller.OrganizationDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="orgDetailsToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="Organization" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList id="navigationList" selectedKey="Organization">
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://home" key="Admin" select="onAdmin"/>
                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement"/>
                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://lightbulb" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://document-text" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="System Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>
                    <tnt:NavigationListItem text="Organization" icon="sap-icon://building" key="Organization" select="onOrganization"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="orgDetailsPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <dependents>
                    <!-- ADD PARAMETER MODAL -->
                    <Dialog id="addParamDialog" title="Add Organization Parameter" contentWidth="500px" stretch="{device>/system/phone}">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <VBox class="xyraFormField">
                                    <Label text="Parameter Type" required="true" class="xyraFormLabel"/>
                                    <Select id="newParamTypeSelect" selectedKey="SET/GET Parameter" width="100%" change="onParamTypeChange">
                                        <core:Item key="SET/GET Parameter" text="SET/GET Parameter"/>
                                        <core:Item key="User Default Value" text="User Default Value"/>
                                    </Select>
                                </VBox>

                                <VBox class="xyraFormField">
                                    <Label text="Parameter ID / Name" required="true" class="xyraFormLabel"/>
                                    <Select id="newParamIdSetGetSelect" visible="true" width="100%">
                                        <core:Item key="BUK - Company Code" text="BUK - Company Code"/>
                                        <core:Item key="WRK - Plant" text="WRK - Plant"/>
                                        <core:Item key="VKO - Sales Organization" text="VKO - Sales Organization"/>
                                        <core:Item key="VTEG - Distribution Channel" text="VTEG - Distribution Channel"/>
                                        <core:Item key="SPA - Memory ID" text="SPA - Memory ID"/>
                                        <core:Item key="KOK - Cost Center" text="KOK - Cost Center"/>
                                        <core:Item key="EKO - Purchasing Organization" text="EKO - Purchasing Organization"/>
                                        <core:Item key="Custom" text="Custom"/>
                                    </Select>

                                    <Select id="newParamIdUserDefSelect" visible="false" width="100%">
                                        <core:Item key="Decimal Notation" text="Decimal Notation"/>
                                        <core:Item key="Date Format" text="Date Format"/>
                                        <core:Item key="Time Zone" text="Time Zone"/>
                                        <core:Item key="Logon Language" text="Logon Language"/>
                                        <core:Item key="Spool Output (DEST)" text="Spool Output (DEST)"/>
                                        <core:Item key="Output Device (PRINTER)" text="Output Device (PRINTER)"/>
                                        <core:Item key="Custom" text="Custom"/>
                                    </Select>
                                </VBox>

                                <VBox class="xyraFormField">
                                    <Label text="Configured Value" required="true" class="xyraFormLabel"/>
                                    <Input id="newParamValueInput" placeholder="e.g. 1000, DD.MM.YYYY, IST"/>
                                </VBox>

                                <VBox class="xyraFormField">
                                    <Label text="Status" required="true" class="xyraFormLabel"/>
                                    <Select id="newParamStatusSelect" selectedKey="Active" width="100%">
                                        <core:Item key="Active" text="Active"/>
                                        <core:Item key="Enforced" text="Enforced"/>
                                        <core:Item key="Pending Verification" text="Pending Verification"/>
                                    </Select>
                                </VBox>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Cancel" press="onCloseAddParamDialog"/>
                        </beginButton>
                        <endButton>
                            <Button text="Add Parameter" type="Emphasized" icon="sap-icon://add" press="onSubmitAddParam"/>
                        </endButton>
                    </Dialog>

                    <!-- EDIT SUMMARY MODAL -->
                    <Dialog id="editSummaryDialog" title="Edit Company Executive Summary" contentWidth="600px" stretch="{device>/system/phone}">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiNoMargin">
                                    <VBox>
                                        <VBox class="xyraFormField">
                                            <Label text="Organization ID" required="true" class="xyraFormLabel"/>
                                            <Input id="editSummaryOrgIdInput" editable="false" placeholder="e.g. ORG-TATA-01"/>
                                        </VBox>

                                        <VBox class="xyraFormField">
                                            <Label text="Company Name" required="true" class="xyraFormLabel"/>
                                            <Input id="editSummaryCompanyNameInput" placeholder="e.g. Tata Sons &amp; Group"/>
                                        </VBox>

                                        <VBox class="xyraFormField">
                                            <Label text="Industry" required="true" class="xyraFormLabel"/>
                                            <Select id="editSummaryIndustrySelect" selectedKey="Conglomerate &amp; Technology" width="100%">
                                                <core:Item key="Conglomerate &amp; Technology" text="Conglomerate &amp; Technology"/>
                                                <core:Item key="IT Consulting &amp; Services" text="IT Consulting &amp; Services"/>
                                                <core:Item key="Enterprise Software" text="Enterprise Software"/>
                                                <core:Item key="Manufacturing &amp; Automotive" text="Manufacturing &amp; Automotive"/>
                                                <core:Item key="Banking &amp; Financial Services" text="Banking &amp; Financial Services"/>
                                                <core:Item key="Energy &amp; Retail" text="Energy &amp; Retail"/>
                                                <core:Item key="Healthcare &amp; Pharmaceuticals" text="Healthcare &amp; Pharmaceuticals"/>
                                                <core:Item key="Custom" text="Custom"/>
                                            </Select>
                                        </VBox>

                                        <VBox class="xyraFormField">
                                            <Label text="Region" required="true" class="xyraFormLabel"/>
                                            <Select id="editSummaryRegionSelect" selectedKey="Asia Pacific" width="100%">
                                                <core:Item key="Asia Pacific" text="Asia Pacific"/>
                                                <core:Item key="North America" text="North America"/>
                                                <core:Item key="Europe" text="Europe"/>
                                                <core:Item key="Latin America" text="Latin America"/>
                                                <core:Item key="Middle East &amp; Africa" text="Middle East &amp; Africa"/>
                                            </Select>
                                        </VBox>

                                        <VBox class="xyraFormField">
                                            <Label text="Status" required="true" class="xyraFormLabel"/>
                                            <Select id="editSummaryStatusSelect" selectedKey="Active" width="100%">
                                                <core:Item key="Active" text="Active"/>
                                                <core:Item key="Pending Setup" text="Pending Setup"/>
                                                <core:Item key="Under Audit Review" text="Under Audit Review"/>
                                                <core:Item key="Inactive" text="Inactive"/>
                                            </Select>
                                        </VBox>
                                    </VBox>

                                    <VBox>
                                        <VBox class="xyraFormField">
                                            <Label text="Country" required="true" class="xyraFormLabel"/>
                                            <Input id="editSummaryCountryInput" placeholder="e.g. India"/>
                                        </VBox>

                                        <VBox class="xyraFormField">
                                            <Label text="Primary Contact" required="true" class="xyraFormLabel"/>
                                            <Input id="editSummaryContactInput" placeholder="e.g. Ratan Sharma (VP GRC)"/>
                                        </VBox>

                                        <VBox class="xyraFormField">
                                            <Label text="Email Address" required="true" class="xyraFormLabel"/>
                                            <Input id="editSummaryEmailInput" type="Email" placeholder="e.g. grc@tata.com"/>
                                        </VBox>

                                        <VBox class="xyraFormField">
                                            <Label text="Phone Number" class="xyraFormLabel"/>
                                            <Input id="editSummaryPhoneInput" placeholder="e.g. +91 22 6665 8282"/>
                                        </VBox>
                                    </VBox>
                                </layout:Grid>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Cancel" press="onCloseEditSummaryDialog"/>
                        </beginButton>
                        <endButton>
                            <Button text="Save Changes" type="Emphasized" icon="sap-icon://save" press="onSubmitEditSummary"/>
                        </endButton>
                    </Dialog>

                    <!-- SLA SETTINGS MODAL -->
                    <Dialog id="slaSettingsDialog" title="Reviewer Escalation SLA Settings" contentWidth="480px" stretch="{device>/system/phone}">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <MessageStrip text="Business-day deadlines for the review chain. The Reviewer 1 clock starts when a deviation is detected; the Reviewer 2 clock starts once Reviewer 1 approves. Escalation Manager has no decision of their own - they're flagged once a Level 2 item is overdue by more than the escalation delay below." type="Information" showIcon="true" class="sapUiSmallMarginBottom"/>

                                <VBox class="xyraFormField">
                                    <Label text="Reviewer 1 SLA (business days)" required="true" class="xyraFormLabel"/>
                                    <Input id="slaReviewer1Days" type="Number"/>
                                </VBox>

                                <VBox class="xyraFormField">
                                    <Label text="Reviewer 2 SLA (business days)" required="true" class="xyraFormLabel"/>
                                    <Input id="slaReviewer2Days" type="Number"/>
                                </VBox>

                                <VBox class="xyraFormField">
                                    <Label text="Escalation delay past Reviewer 2 SLA (business days)" required="true" class="xyraFormLabel"/>
                                    <Input id="slaEscalationDelayDays" type="Number"/>
                                </VBox>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Cancel" press="onCloseSlaSettingsDialog"/>
                        </beginButton>
                        <endButton>
                            <Button text="Save Changes" type="Emphasized" icon="sap-icon://save" press="onSaveSlaSettings"/>
                        </endButton>
                    </Dialog>
                </dependents>

                <!-- PAGE HEADER WITH BACK BUTTON & SUMMARY -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            text="Back to Organizations"
                            icon="sap-icon://nav-back"
                            type="Transparent"
                            press="onNavBack"
                            class="sapUiTinyMarginBegin"/>
                        <ToolbarSeparator/>
                        <VBox justifyContent="Center">
                            <Title text="{orgDetailsModel>/currentOrg/companyName} ({orgDetailsModel>/currentOrg/orgId})" level="H4" class="sapUiNoMargin"/>
                            <Text text="Enterprise Governance &amp; Configuration Sub-Page" class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>
                        <ObjectStatus text="{orgDetailsModel>/currentOrg/status}" state="{orgDetailsModel>/currentOrg/statusState}" icon="sap-icon://shield" class="sapUiSmallMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- Company summary now lives only in the Company Details tab's
                             Organization Profile panel - no need for a second, duplicate
                             card showing the same fields above the tabs. -->

                        <!-- TABS FOR COMPANY DETAILS, CONFIGURATIONS, PARAMETERS, POLICIES -->
                        <IconTabBar id="orgDetailsTabBar" class="sapUiNoMargin">
                            <items>

                                <!-- TAB 1: COMPANY DETAILS -->
                                <IconTabFilter icon="sap-icon://building" text="Company Details" key="details">
                                    <VBox width="100%" class="sapUiSmallMarginTop">
                                        <layout:Grid defaultSpan="XL6 L6 M12 S12">
                                            <!-- ORGANIZATION PROFILE PANEL -->
                                            <Panel expandable="false">
                                                <headerToolbar>
                                                    <OverflowToolbar height="3rem">
                                                        <Title text="Organization Profile" level="H4" class="sapUiTinyMarginBegin"/>
                                                        <ToolbarSpacer/>
                                                        <Button text="Edit" icon="sap-icon://edit" type="Transparent" press="onEditSummaryPress"/>
                                                    </OverflowToolbar>
                                                </headerToolbar>
                                                <VBox class="sapUiSmallMargin">
                                                    <Label text="Company Name" design="Bold"/>
                                                    <Text text="{orgDetailsModel>/currentOrg/companyName}" class="sapUiSmallMarginBottom"/>

                                                    <Label text="Organization ID" design="Bold"/>
                                                    <Text text="{orgDetailsModel>/currentOrg/orgId}" class="sapUiSmallMarginBottom"/>

                                                    <Label text="Industry" design="Bold"/>
                                                    <Text text="{orgDetailsModel>/currentOrg/industry}" class="sapUiSmallMarginBottom"/>

                                                    <Label text="Region &amp; Country" design="Bold"/>
                                                    <Text text="{orgDetailsModel>/currentOrg/region} ({orgDetailsModel>/currentOrg/country})"/>
                                                </VBox>
                                            </Panel>

                                            <!-- CONTACT & STATUS PANEL -->
                                            <Panel headerText="Contact &amp; Status" expandable="false">
                                                <VBox class="sapUiSmallMargin">
                                                    <Label text="Primary Contact" design="Bold"/>
                                                    <Text text="{orgDetailsModel>/currentOrg/primaryContact}" class="sapUiSmallMarginBottom"/>

                                                    <Label text="Email Address" design="Bold"/>
                                                    <Text text="{orgDetailsModel>/currentOrg/email}" class="sapUiSmallMarginBottom"/>

                                                    <Label text="Phone Number" design="Bold"/>
                                                    <Text text="{orgDetailsModel>/currentOrg/phone}" class="sapUiSmallMarginBottom"/>

                                                    <Label text="Status" design="Bold"/>
                                                    <ObjectStatus text="{orgDetailsModel>/currentOrg/status}" state="{orgDetailsModel>/currentOrg/statusState}"/>
                                                </VBox>
                                            </Panel>
                                        </layout:Grid>
                                    </VBox>
                                </IconTabFilter>

                                <!-- TAB 2: CONFIGURATIONS -->
                                <IconTabFilter icon="sap-icon://action-settings" text="Configurations" key="config">
                                    <VBox width="100%" class="sapUiSmallMarginTop">
                                        <Panel expandable="false">
                                            <headerToolbar>
                                                <OverflowToolbar height="3.5rem">
                                                    <Title text="SAP Systems under this Organization" level="H3" class="sapUiSmallMarginBegin"/>
                                                    <ToolbarSpacer/>
                                                    <ObjectStatus text="{= ${orgDetailsModel>/orgSystems}.length + ' System(s)' }" state="Information" class="sapUiSmallMarginEnd"/>
                                                </OverflowToolbar>
                                            </headerToolbar>

                                            <Table id="orgSystemsTable" items="{orgDetailsModel>/orgSystems}" mode="None" width="100%" noDataText="No Systems are assigned to this Organization yet - add one from System Configuration.">
                                                <columns>
                                                    <Column width="10%"><Text text="System ID"/></Column>
                                                    <Column width="8%"><Text text="Client"/></Column>
                                                    <Column width="12%"><Text text="Type"/></Column>
                                                    <Column width="20%"><Text text="Host Name"/></Column>
                                                    <Column width="12%"><Text text="Platform"/></Column>
                                                    <Column width="12%"><Text text="Region"/></Column>
                                                    <Column width="12%"><Text text="Sector"/></Column>
                                                    <Column width="14%"><Text text="Connection"/></Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem>
                                                        <cells>
                                                            <Text text="{orgDetailsModel>sysId}" class="fontWeightBold"/>
                                                            <Text text="{orgDetailsModel>client}"/>
                                                            <Text text="{orgDetailsModel>sysType}"/>
                                                            <Text text="{orgDetailsModel>hostName}"/>
                                                            <Text text="{orgDetailsModel>platform}"/>
                                                            <Text text="{orgDetailsModel>region}"/>
                                                            <Text text="{orgDetailsModel>sector}"/>
                                                            <ObjectStatus text="{orgDetailsModel>lastConnectionStatus}" state="{orgDetailsModel>connectionState}"/>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </Panel>
                                    </VBox>
                                </IconTabFilter>

                                <!-- TAB 3: PARAMETERS -->
                                <IconTabFilter icon="sap-icon://chain-link" text="Parameters" key="parameters">
                                    <VBox width="100%" class="sapUiSmallMarginTop">
                                        <Panel expandable="false">
                                            <headerToolbar>
                                                <OverflowToolbar height="3.5rem">
                                                    <Title text="Organization-Specific SAP Parameters" level="H3" class="sapUiSmallMarginBegin"/>
                                                    <ToolbarSpacer/>

                                                    <!-- PARAMETER TYPE FILTER -->
                                                    <Select id="paramTypeFilterSelect" selectedKey="All" change="onFilterParameters" width="13rem" class="sapUiTinyMarginEnd">
                                                        <core:Item key="All" text="All Parameter Types"/>
                                                        <core:Item key="SET/GET Parameter" text="SET/GET Parameter"/>
                                                        <core:Item key="User Default Value" text="User Default Value"/>
                                                    </Select>

                                                    <Button text="Add Parameter" icon="sap-icon://add" type="Emphasized" press="onOpenAddParamDialog" class="sapUiSmallMarginEnd"/>
                                                </OverflowToolbar>
                                            </headerToolbar>

                                            <Table id="paramsTable" items="{orgDetailsModel>/parameters}" mode="None" width="100%" class="sapUiNoMargin">
                                                <columns>
                                                    <Column width="22%"><Text text="Parameter Type"/></Column>
                                                    <Column width="30%"><Text text="Parameter ID / Name"/></Column>
                                                    <Column width="20%"><Text text="Configured Value"/></Column>
                                                    <Column width="14%"><Text text="Status"/></Column>
                                                    <Column width="14%" hAlign="Center"><Text text="Actions"/></Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem vAlign="Middle">
                                                        <cells>
                                                            <ObjectStatus text="{orgDetailsModel>paramType}" state="Information"/>
                                                            <Text text="{orgDetailsModel>paramIdName}" class="fontWeightBold"/>
                                                            <Text text="{orgDetailsModel>value}"/>
                                                            <ObjectStatus text="{orgDetailsModel>status}" state="{orgDetailsModel>statusState}"/>
                                                            <Button icon="sap-icon://delete" type="Transparent" tooltip="Remove Parameter" press="onRemoveParameter"/>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </Panel>
                                    </VBox>
                                </IconTabFilter>

                                <!-- TAB 4: POLICIES -->
                                <IconTabFilter icon="sap-icon://shield" text="Policies" key="policies">
                                    <VBox width="100%" class="sapUiSmallMarginTop">
                                        <Panel expandable="false">
                                            <headerToolbar>
                                                <OverflowToolbar height="3.5rem">
                                                    <Title text="Review SLA Policy" level="H3" class="sapUiSmallMarginBegin"/>
                                                    <ToolbarSpacer/>
                                                    <Button text="Edit SLA Settings" icon="sap-icon://edit" type="Emphasized" press="onOpenSlaSettingsDialog" class="sapUiSmallMarginEnd"/>
                                                </OverflowToolbar>
                                            </headerToolbar>

                                            <VBox class="sapUiMediumMargin">
                                                <MessageStrip
                                                    text="The one governance policy this organization currently enforces: business-day deadlines for the Reviewer 1 -&gt; Reviewer 2 deviation review chain, and when an overdue item gets flagged for the Escalation Manager."
                                                    type="Information" showIcon="true" class="sapUiSmallMarginBottom"/>
                                                <Label text="Reviewer Escalation SLA Window" design="Bold"/>
                                                <Text text="{orgDetailsModel>/slaSummary}"/>
                                            </VBox>
                                        </Panel>
                                    </VBox>
                                </IconTabFilter>

                                <!-- TAB 5: TICKETING INTEGRATION -->
                                <IconTabFilter icon="sap-icon://connected" text="Ticketing Integration" key="ticketing">
                                    <VBox width="100%" class="sapUiSmallMarginTop">
                                        <Panel expandable="false">
                                            <headerToolbar>
                                                <OverflowToolbar height="3.5rem">
                                                    <Title text="Ticketing Integration" level="H3" class="sapUiSmallMarginBegin"/>
                                                    <ToolbarSpacer/>
                                                    <Button text="Save" icon="sap-icon://save" type="Emphasized" press="onSaveJiraSettings" class="sapUiSmallMarginEnd"/>
                                                </OverflowToolbar>
                                            </headerToolbar>

                                            <VBox class="sapUiMediumMargin">
                                                <Label text="Platform" design="Bold" class="sapUiTinyMarginBottom"/>
                                                <SegmentedButton id="ticketingProviderSelector" selectedKey="jira" class="sapUiSmallMarginBottom">
                                                    <items>
                                                        <SegmentedButtonItem key="jira" text="Jira"/>
                                                        <SegmentedButtonItem key="servicenow" text="ServiceNow (Coming Soon)" enabled="false"/>
                                                        <SegmentedButtonItem key="salesforce" text="Salesforce (Coming Soon)" enabled="false"/>
                                                    </items>
                                                </SegmentedButton>

                                                <MessageStrip
                                                    text="When enabled, rejecting a deviation for a System under this Organization creates a real Jira issue instead of a local placeholder ticket number. The API token is never shown back once saved."
                                                    type="Information" showIcon="true" class="sapUiSmallMarginBottom"/>

                                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                                    <Switch id="jiraEnabledSwitch" state="{orgDetailsModel>/jiraSettings/enabled}"/>
                                                    <Label text="Enable Jira ticket creation for this Organization" class="sapUiTinyMarginBegin"/>
                                                </HBox>

                                                <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiNoMargin">
                                                    <VBox>
                                                        <VBox class="xyraFormField">
                                                            <Label text="Jira Site URL" required="true" class="xyraFormLabel"/>
                                                            <Input id="jiraSiteUrlInput" placeholder="https://yourcompany.atlassian.net" value="{orgDetailsModel>/jiraSettings/siteUrl}"/>
                                                        </VBox>
                                                        <VBox class="xyraFormField">
                                                            <Label text="Atlassian Account Email" required="true" class="xyraFormLabel"/>
                                                            <Input id="jiraEmailInput" type="Email" placeholder="you@company.com" value="{orgDetailsModel>/jiraSettings/email}"/>
                                                        </VBox>
                                                        <VBox class="xyraFormField">
                                                            <Label text="API Token" class="xyraFormLabel"/>
                                                            <Input id="jiraApiTokenInput" type="Password" placeholder="{= ${orgDetailsModel>/jiraSettings/hasToken} ? 'Token on file - leave blank to keep it' : 'Paste your Atlassian API token' }"/>
                                                        </VBox>
                                                    </VBox>
                                                    <VBox>
                                                        <VBox class="xyraFormField">
                                                            <Label text="Project (Space) Key" required="true" class="xyraFormLabel"/>
                                                            <Input id="jiraProjectKeyInput" placeholder="e.g. XS" value="{orgDetailsModel>/jiraSettings/projectKey}"/>
                                                        </VBox>
                                                        <VBox class="xyraFormField">
                                                            <Label text="Issue Type" class="xyraFormLabel"/>
                                                            <Input id="jiraIssueTypeInput" placeholder="Task" value="{orgDetailsModel>/jiraSettings/issueType}"/>
                                                        </VBox>
                                                    </VBox>
                                                </layout:Grid>

                                                <Title text="Status Mapping" level="H4" class="sapUiMediumMarginTop sapUiTinyMarginBottom"/>
                                                <MessageStrip
                                                    text="Every Jira board names its own statuses. Fetch this board's real statuses, then map which one means each stage below - unmapped stages fall back to Jira's own To Do / In Progress / Done categories."
                                                    type="Information" showIcon="true" class="sapUiSmallMarginBottom"/>
                                                <Button text="Fetch Live Statuses from Jira" icon="sap-icon://refresh" press="onFetchJiraStatuses" class="sapUiSmallMarginBottom"/>

                                                <layout:Grid defaultSpan="XL4 L4 M12 S12" class="sapUiNoMargin">
                                                    <VBox class="xyraFormField">
                                                        <Label text="Ticket Created" class="xyraFormLabel"/>
                                                        <Select id="jiraStatusCreatedSelect" selectedKey="{orgDetailsModel>/jiraSettings/statusCreated}" items="{orgDetailsModel>/jiraStatusOptions}" width="100%">
                                                            <core:Item key="{orgDetailsModel>key}" text="{orgDetailsModel>text}"/>
                                                        </Select>
                                                    </VBox>
                                                    <VBox class="xyraFormField">
                                                        <Label text="In Progress" class="xyraFormLabel"/>
                                                        <Select id="jiraStatusInProgressSelect" selectedKey="{orgDetailsModel>/jiraSettings/statusInProgress}" items="{orgDetailsModel>/jiraStatusOptions}" width="100%">
                                                            <core:Item key="{orgDetailsModel>key}" text="{orgDetailsModel>text}"/>
                                                        </Select>
                                                    </VBox>
                                                    <VBox class="xyraFormField">
                                                        <Label text="Resolved" class="xyraFormLabel"/>
                                                        <Select id="jiraStatusResolvedSelect" selectedKey="{orgDetailsModel>/jiraSettings/statusResolved}" items="{orgDetailsModel>/jiraStatusOptions}" width="100%">
                                                            <core:Item key="{orgDetailsModel>key}" text="{orgDetailsModel>text}"/>
                                                        </Select>
                                                    </VBox>
                                                </layout:Grid>
                                            </VBox>
                                        </Panel>
                                    </VBox>
                                </IconTabFilter>

                            </items>
                        </IconTabBar>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
