<mvc:View
    controllerName="xyraweb.controller.AutomationMonitoring"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="automationMonitoringToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="ControlManagement" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://shield" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Role Management" icon="sap-icon://manager" key="RoleManagement" select="onRoleManagement">
                        <tnt:tag>
                            <ObjectStatus text="380 Roles" state="Indication17" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement">
                        <tnt:tag>
                            <ObjectStatus text="156 Controls" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://machine" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://business-objects-experience" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="System Health" icon="sap-icon://sys-monitor" key="SystemHealth" select="onSystemHealth"/>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="automationMonitoringPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <dependents>
                    <!-- EXECUTION LOGS DIALOG -->
                    <Dialog
                        id="jobLogsDialog"
                        title="Monitoring Execution Logs"
                        contentWidth="680px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <!-- JOB DETAILS HEADER CARD -->
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                    <VBox>
                                        <Title id="logJobIdTitle" text="Job ID: AUTO-JOB-101" level="H3"/>
                                        <Text id="logControlNameText" text="Segregation of Duties (SoD) Conflict Scan" class="textMuted"/>
                                    </VBox>
                                    <ObjectStatus id="logJobStatus" text="SUCCESS" state="Success" icon="sap-icon://sys-enter-2"/>
                                </HBox>

                                <Table id="logEntriesTable" items="{logsModel>/logEntries}" mode="None" class="sapUiTinyMarginTop">
                                    <columns>
                                        <Column width="25%"><Text text="Timestamp"/></Column>
                                        <Column width="15%"><Text text="Log Level"/></Column>
                                        <Column width="60%"><Text text="Message / Event Trace"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{logsModel>timestamp}"/>
                                                <ObjectStatus text="{logsModel>level}" state="{logsModel>levelState}"/>
                                                <Text text="{logsModel>message}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Download Log" icon="sap-icon://download" type="Ghost" press="onDownloadLogs"/>
                        </beginButton>
                        <endButton>
                            <Button text="Close" press="onCloseLogsDialog"/>
                        </endButton>
                    </Dialog>
                </dependents>

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <Avatar initials="AM" displaySize="S" backgroundColor="Accent6" class="sapUiTinyMarginEnd"/>
                        <VBox justifyContent="Center">
                            <Title text="⚙️ XYRA – Automation Monitoring" level="H4" class="sapUiNoMargin"/>
                            <Text text="Track automated control execution schedules, deviation counts, and job logs." class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Admin Dashboard" type="Transparent" press="onAdmin" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- TAB NAVIGATION BUTTONS -->
                        <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Button text="Control Management" icon="sap-icon://shield" type="Transparent" press="onNavControlManagement" class="sapUiTinyMarginEnd"/>
                            <Button text="Automation Monitoring" icon="sap-icon://sys-monitor" type="Emphasized"/>
                        </HBox>

                        <!-- AUTOMATION MONITORING TABLE -->
                        <Panel expandable="false" class="sapUiSmallMarginBottom">
                            <Table id="automationTable" items="{automationModel>/jobs}" mode="None" width="100%">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Automated Control Jobs &amp; Monitoring Logs" level="H3"/>
                                        <ToolbarSpacer/>
                                        <SearchField width="16rem" placeholder="Search jobs, logs..." search="onSearchJobs"/>
                                        <Select selectedKey="All" change="onFilterStatus">
                                            <core:Item key="All" text="All Statuses"/>
                                            <core:Item key="SUCCESS" text="Success"/>
                                            <core:Item key="FAILED" text="Failed"/>
                                            <core:Item key="RUNNING" text="Running"/>
                                        </Select>
                                        <Button text="Retry Failed Jobs" icon="sap-icon://refresh" type="Emphasized" press="onRetryFailedJobs"/>
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column width="10%"><Text text="Job ID"/></Column>
                                    <Column width="20%"><Text text="Control Name"/></Column>
                                    <Column width="13%"><Text text="Automation Schedule"/></Column>
                                    <Column width="14%"><Text text="Last Execution"/></Column>
                                    <Column width="14%"><Text text="Next Execution"/></Column>
                                    <Column width="7%"><Text text="Status"/></Column>
                                    <Column width="8%" hAlign="Center"><Text text="Deviations"/></Column>
                                    <Column width="14%" hAlign="Center"><Text text="Actions"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{automationModel>jobId}"/>
                                            <Text text="{automationModel>controlName}"/>
                                            <Text text="{automationModel>schedule}"/>
                                            <Text text="{automationModel>lastExecution}"/>
                                            <Text text="{automationModel>nextExecution}"/>
                                            <ObjectStatus text="{automationModel>executionStatus}" state="{automationModel>statusState}"/>
                                            <ObjectStatus text="{automationModel>deviationCount} Deviations" state="{automationModel>deviationState}" inverted="true"/>
                                            <HBox justifyContent="Center" alignItems="Center">
                                                <Button text="Logs" type="Emphasized" press="onViewLogs" class="sapUiTinyMarginEnd"/>
                                                <Button text="Retry" type="Ghost" press="onRetrySingleJob" enabled="{= ${automationModel>executionStatus} === 'FAILED' }"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <Text text="Version 1.0 | Status: Active"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
