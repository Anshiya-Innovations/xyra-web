<mvc:View
    controllerName="xyraweb.controller.AutomationMonitoring"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="automationMonitoringToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
                        <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="AutomationMonitoring" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://home" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement"/>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://lightbulb" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://document-text" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="automationMonitoringPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <dependents>
                    <!-- RULE & DEVIATION EVALUATION DIALOG -->
                    <Dialog
                        id="ruleDetailsDialog"
                        title="Security Control Rule Evaluation &amp; Deviation Details"
                        contentWidth="750px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                    <VBox>
                                        <Title id="ruleControlIdTitle" text="Control ID: XYRA-08" level="H3"/>
                                        <Text id="ruleControlDescText" text="SAP Java Audit Log Filters &amp; Security Event Monitoring" class="textMuted"/>
                                    </VBox>
                                    <ObjectStatus id="ruleOverallStatus" text="No Deviation" state="None" inverted="true" class="badgeWhite"/>
                                </HBox>

                                <MessageStrip
                                    id="ruleStatusMessageStrip"
                                    text="Rule Satisfied: All evaluated security parameters meet target specifications with 0 deviations."
                                    type="Success"
                                    showIcon="true"
                                    class="sapUiSmallMarginBottom"/>

                                <Table id="ruleDetailsTable" items="{ruleDetailsModel>/rules}" mode="None" class="sapUiTinyMarginTop">
                                    <columns>
                                        <Column width="22%"><Text text="Parameter"/></Column>
                                        <Column width="15%"><Text text="Operator"/></Column>
                                        <Column width="18%"><Text text="Expected Value"/></Column>
                                        <Column width="18%"><Text text="Actual Value"/></Column>
                                        <Column width="27%"><Text text="Result Status"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{ruleDetailsModel>parameter}" class="fontWeightBold"/>
                                                <Text text="{ruleDetailsModel>operator}"/>
                                                <Text text="{ruleDetailsModel>expectedValue}"/>
                                                <Text text="{ruleDetailsModel>actualValue}"/>
                                                <ObjectStatus text="{ruleDetailsModel>statusText}" state="{ruleDetailsModel>statusState}" icon="{ruleDetailsModel>statusIcon}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </content>
                        <endButton>
                            <Button text="Close" press="onCloseRuleDialog"/>
                        </endButton>
                    </Dialog>

                    <!-- EXECUTION LOGS DIALOG -->
                    <Dialog
                        id="jobLogsDialog"
                        title="Automation Execution Logs"
                        contentWidth="680px">
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                    <VBox>
                                        <Title id="logJobIdTitle" text="Control ID: XYRA-08" level="H3"/>
                                        <Text id="logControlNameText" text="SAP Java Audit Log Filters &amp; Security Event Monitoring" class="textMuted"/>
                                    </VBox>
                                    <ObjectStatus id="logJobStatus" text="SUCCESS" state="Success" icon="sap-icon://sys-enter-2"/>
                                </HBox>

                                <Table id="logEntriesTable" items="{logsModel>/logEntries}" mode="None" class="sapUiTinyMarginTop">
                                    <columns>
                                        <Column width="25%"><Text text="Timestamp"/></Column>
                                        <Column width="15%"><Text text="Log Level"/></Column>
                                        <Column width="60%"><Text text="Message / Event Trace"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{logsModel>timestamp}"/>
                                                <ObjectStatus text="{logsModel>level}" state="{logsModel>levelState}"/>
                                                <Text text="{logsModel>message}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </content>
                        <beginButton>
                            <Button text="Download Log" icon="sap-icon://download" type="Ghost" press="onDownloadLogs"/>
                        </beginButton>
                        <endButton>
                            <Button text="Close" press="onCloseLogsDialog"/>
                        </endButton>
                    </Dialog>
                </dependents>

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <Avatar initials="AM" displaySize="S" backgroundColor="Accent6" class="sapUiTinyMarginEnd"/>
                        <VBox justifyContent="Center">
                            <Title text="XYRA – Automation Monitoring" level="H4" class="sapUiNoMargin"/>
                            <Text text="Track automated control execution schedules, deviation counts, and job logs." class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Admin Dashboard" type="Transparent" press="onAdmin" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- TAB NAVIGATION BUTTONS -->
                        <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Button text="Control Management" icon="sap-icon://shield" type="Transparent" press="onNavControlManagement" class="sapUiTinyMarginEnd"/>
                            <Button text="Basis Deviation Report" icon="sap-icon://alert" type="Transparent" press="onNavDeviationReport"/>
                        </HBox>

                        <!-- AUTOMATION MONITORING TABLE -->
                        <Panel expandable="false" class="sapUiSmallMarginBottom">
                            <Table id="automationTable" items="{automationModel>/controls}" mode="None" width="100%">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Security Control Master Directory" level="H3"/>
                                        <ToolbarSpacer/>
                                        <SearchField id="searchAutomationId" width="16rem" placeholder="Search Control ID..." search="onSearchControls" liveChange="onSearchControls"/>
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column width="10%"><Text text="Control ID"/></Column>
                                    <Column width="26%"><Text text="Control Description"/></Column>
                                    <Column width="7%" hAlign="Center"><Text text="System Type"/></Column>
                                    <Column width="7%" hAlign="Center"><Text text="System Type"/></Column>
                                    <Column width="7%" hAlign="Center"><Text text="System Type"/></Column>
                                    <Column width="14%"><Text text="Frequency Run"/></Column>
                                    <Column width="7%" hAlign="Center"><Text text="Total Run"/></Column>
                                    <Column width="10%" hAlign="Center"><Text text="Deviations"/></Column>
                                    <Column width="12%" hAlign="Center"><Text text="Actions"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{automationModel>id}" class="sapUiSelectable fontWeightBold"/>
                                            <Text text="{automationModel>description}"/>
                                            <ObjectStatus text="{automationModel>sysType1}" state="{= ${automationModel>sysType1} === 'None' ? 'None' : (${automationModel>sysType1} === 'PRD' ? 'Error' : (${automationModel>sysType1} === 'QAS' ? 'Warning' : 'Information')) }"/>
                                            <ObjectStatus text="{automationModel>sysType2}" state="{= ${automationModel>sysType2} === 'None' ? 'None' : (${automationModel>sysType2} === 'PRD' ? 'Error' : (${automationModel>sysType2} === 'QAS' ? 'Warning' : 'Information')) }"/>
                                            <ObjectStatus text="{automationModel>sysType3}" state="{= ${automationModel>sysType3} === 'None' ? 'None' : (${automationModel>sysType3} === 'PRD' ? 'Error' : (${automationModel>sysType3} === 'QAS' ? 'Warning' : 'Information')) }"/>
                                            <Text text="{automationModel>frequencyRun}"/>
                                            <Text text="{automationModel>totalRun}" class="fontWeightBold textSuccess"/>
                                            <ObjectStatus text="{automationModel>deviationLabel}" state="{automationModel>deviationState}" inverted="true" class="{automationModel>deviationClass}"/>
                                            <HBox justifyContent="Center" alignItems="Center">
                                                <Button text="Rule" type="Emphasized" press="onViewRule" class="sapUiTinyMarginEnd"/>
                                                <Button text="Logs" type="Ghost" press="onViewLogs"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <Text text="Control Management v1.0 | Status: Active"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
