<mvc:View
    controllerName="xyraweb.controller.RoleManagement"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="roleManagementToolPage" sideExpanded="true">

        <!-- ENTERPRISE MANAGEMENT SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="RoleManagement" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://shield" key="Admin" select="onAdmin"/>

                    <tnt:NavigationListItem text="Role Management" icon="sap-icon://manager" key="RoleManagement" select="onRoleManagement">
                        <tnt:tag>
                            <ObjectStatus text="380 Roles" state="Indication17" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Control Management" icon="sap-icon://shield" key="ControlManagement" select="onControlManagement">
                        <tnt:tag>
                            <ObjectStatus text="156 Controls" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="AI Insights" icon="sap-icon://machine" key="AIInsights" select="onAIInsights">
                        <tnt:tag>
                            <ObjectStatus text="New" state="Indication15" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="SOX Compliance" icon="sap-icon://accept" key="SOXCompliance" select="onSOXCompliance">
                        <tnt:tag>
                            <ObjectStatus text="98.4%" state="Indication16" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="Reports" icon="sap-icon://business-objects-experience" key="Reports" select="onReports"/>
                    <tnt:NavigationListItem text="Audit Logs" icon="sap-icon://history" key="AuditLogs" select="onAuditLogs"/>
                    <tnt:NavigationListItem text="Configuration" icon="sap-icon://action-settings" key="Configuration" select="onConfiguration"/>
                    <tnt:NavigationListItem text="Access Management" icon="sap-icon://key-user-settings" key="AccessManagement" select="onAccessManagement"/>

                    <tnt:NavigationListItem text="Risk Analytics" icon="sap-icon://bar-chart" key="RiskAnalytics" select="onRiskAnalytics">
                        <tnt:tag>
                            <ObjectStatus text="3 Risks" state="Indication18" inverted="true"/>
                        </tnt:tag>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem text="System Health" icon="sap-icon://sys-monitor" key="SystemHealth" select="onSystemHealth"/>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="roleManagementPage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <Avatar initials="RM" displaySize="S" backgroundColor="Accent3" class="sapUiTinyMarginEnd"/>
                        <VBox justifyContent="Center">
                            <Title text="🛡️ XYRA – Role Management" level="H4" class="sapUiNoMargin"/>
                            <Text text="Manage SAP enterprise roles, authorization objects, T-Codes, and compliance definitions." class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Admin Dashboard" type="Transparent" press="onAdmin" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- NAVIGATION BUTTONS -->
                        <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Button text="Management" icon="sap-icon://manager" type="Emphasized" class="sapUiTinyMarginEnd"/>
                            <Button text="Role Review" icon="sap-icon://history" type="Transparent" press="onNavRoleReview"/>
                        </HBox>

                        <!-- CARDS SECTION 1: ROLE INFORMATION & AUTHORIZATION -->
                        <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiNoMargin">

                            <!-- CARD 1: ROLE INFORMATION -->
                            <f:Card class="sapUiTinyMarginBottom">
                                <f:header>
                                    <card:Header
                                        title="Role Information"
                                        subtitle="Core SAP Role Attributes &amp; System Metadata"
                                        iconSrc="sap-icon://role"/>
                                </f:header>
                                <f:content>
                                    <VBox class="sapUiMediumMargin">
                                        <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiNoMargin">
                                            <VBox>
                                                <Label text="Role ID" required="true"/>
                                                <Input id="roleIdInput" value="Z_SAP_FIN_FI_POSTING" class="sapUiSmallMarginBottom"/>

                                                <Label text="Role Name" required="true"/>
                                                <Input id="roleNameInput" value="FI Financial Journal Posting Lead" class="sapUiSmallMarginBottom"/>

                                                <Label text="Role Type" required="true"/>
                                                <Select id="roleTypeSelect" selectedKey="Single Role" width="100%" class="sapUiSmallMarginBottom">
                                                    <core:Item key="Single Role" text="Single Role"/>
                                                    <core:Item key="Composite Role" text="Composite Role"/>
                                                    <core:Item key="Derived Role" text="Derived Role"/>
                                                </Select>

                                                <Label text="SAP System" required="true"/>
                                                <Select id="roleSystemSelect" selectedKey="PRD-100" width="100%" class="sapUiSmallMarginBottom">
                                                    <core:Item key="PRD-100" text="PRD-100 (Production)"/>
                                                    <core:Item key="QAS-200" text="QAS-200 (Quality)"/>
                                                    <core:Item key="DEV-300" text="DEV-300 (Development)"/>
                                                </Select>
                                            </VBox>

                                            <VBox>
                                                <Label text="Client" required="true"/>
                                                <Input id="roleClientInput" value="100" class="sapUiSmallMarginBottom"/>

                                                <Label text="Role Owner" required="true"/>
                                                <Input id="roleOwnerInput" value="Sarah Jenkins (Finance Lead)" class="sapUiSmallMarginBottom"/>

                                                <Label text="Status" required="true"/>
                                                <Select id="roleStatusSelect" selectedKey="Active" width="100%" class="sapUiSmallMarginBottom">
                                                    <core:Item key="Active" text="Active"/>
                                                    <core:Item key="Under Review" text="Under Review"/>
                                                    <core:Item key="Deprecated" text="Deprecated"/>
                                                </Select>

                                                <Label text="Description"/>
                                                <Input id="roleDescInput" value="Authorizes GL posting, document reversal, and period closing" class="sapUiSmallMarginBottom"/>
                                            </VBox>
                                        </layout:Grid>
                                    </VBox>
                                </f:content>
                            </f:Card>

                            <!-- CARD 2: AUTHORIZATION & CONTROL -->
                            <f:Card class="sapUiTinyMarginBottom">
                                <f:header>
                                    <card:Header
                                        title="Authorization &amp; Access Controls"
                                        subtitle="T-Codes, Auth Objects &amp; Hierarchy Mapping"
                                        iconSrc="sap-icon://key-user-settings"/>
                                </f:header>
                                <f:content>
                                    <VBox class="sapUiMediumMargin">
                                        <Label text="Authorization Objects"/>
                                        <Input id="roleAuthObjectsInput" value="F_BKPF_BUK, F_BKPF_BLA, S_TCODE, S_TABU_DIS" class="sapUiSmallMarginBottom"/>

                                        <Label text="Transaction Codes (T-Codes)"/>
                                        <Input id="roleTCodesInput" value="FB50, FB01, F-02, F110, KS01" class="sapUiSmallMarginBottom"/>

                                        <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiNoMargin">
                                            <VBox>
                                                <Label text="Critical Authorizations"/>
                                                <Select id="roleCriticalSelect" selectedKey="Sensitive - High Risk" width="100%" class="sapUiSmallMarginBottom">
                                                    <core:Item key="Sensitive - High Risk" text="Sensitive - High Risk"/>
                                                    <core:Item key="Standard Access" text="Standard Access"/>
                                                    <core:Item key="SoD Conflict Risk" text="SoD Conflict Risk"/>
                                                </Select>
                                            </VBox>
                                            <VBox>
                                                <Label text="Composite Role Mapping"/>
                                                <Input id="roleCompositeInput" value="Z_COMP_FINANCE_LEAD" class="sapUiSmallMarginBottom"/>
                                            </VBox>
                                        </layout:Grid>

                                        <Label text="Single Role Association"/>
                                        <Input id="roleSingleInput" value="Z_SINGLE_FI_POST_01" class="sapUiSmallMarginBottom"/>

                                        <!-- ACTION BUTTONS -->
                                        <HBox justifyContent="End" alignItems="Center" class="sapUiTinyMarginTop">
                                            <Button text="Create" icon="sap-icon://add" type="Emphasized" press="onCreateRole" class="sapUiTinyMarginEnd"/>
                                            <Button text="Save" icon="sap-icon://save" type="Default" press="onSaveRole" class="sapUiTinyMarginEnd"/>
                                            <Button text="Update" icon="sap-icon://edit" type="Default" press="onUpdateRole" class="sapUiTinyMarginEnd"/>
                                            <Button text="Delete" icon="sap-icon://delete" type="Reject" press="onDeleteRole" class="sapUiTinyMarginEnd"/>
                                            <Button text="Export" icon="sap-icon://download" type="Ghost" press="onExportRoles"/>
                                        </HBox>
                                    </VBox>
                                </f:content>
                            </f:Card>

                        </layout:Grid>

                        <!-- RESPONSIVE SAP TABLE: ROLE DIRECTORY -->
                        <Panel expandable="false" class="sapUiSmallMarginTop">
                            <Table id="rolesTable" items="{rolesModel>/roles}" mode="None" width="100%">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="SAP Enterprise Role Directory" level="H3"/>
                                        <ToolbarSpacer/>
                                        <SearchField width="16rem" placeholder="Search role ID, name..." search="onSearchRoles"/>
                                        <Select selectedKey="All" change="onFilterRoleType">
                                            <core:Item key="All" text="All Types"/>
                                            <core:Item key="Single Role" text="Single Role"/>
                                            <core:Item key="Composite Role" text="Composite Role"/>
                                            <core:Item key="Derived Role" text="Derived Role"/>
                                        </Select>
                                        <Select selectedKey="RoleId" change="onSortRoles">
                                            <core:Item key="RoleId" text="Sort by Role ID"/>
                                            <core:Item key="RoleName" text="Sort by Role Name"/>
                                            <core:Item key="LastModified" text="Sort by Date"/>
                                        </Select>
                                        <Button text="Export" icon="sap-icon://excel-attachment" type="Ghost" press="onExportRoles"/>
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column width="14%"><Text text="Role ID"/></Column>
                                    <Column width="22%"><Text text="Role Name"/></Column>
                                    <Column width="12%"><Text text="Role Type"/></Column>
                                    <Column width="10%"><Text text="SAP System"/></Column>
                                    <Column width="6%"><Text text="Client"/></Column>
                                    <Column width="16%"><Text text="Owner"/></Column>
                                    <Column width="10%"><Text text="Status"/></Column>
                                    <Column width="10%" hAlign="End"><Text text="Last Modified"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{rolesModel>roleId}"/>
                                            <Text text="{rolesModel>roleName}"/>
                                            <Text text="{rolesModel>roleType}"/>
                                            <Text text="{rolesModel>system}"/>
                                            <Text text="{rolesModel>client}"/>
                                            <Text text="{rolesModel>owner}"/>
                                            <ObjectStatus text="{rolesModel>status}" state="{rolesModel>statusState}"/>
                                            <Text text="{rolesModel>lastModified}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </Panel>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <Text text="Version 1.0 | Status: Active"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
