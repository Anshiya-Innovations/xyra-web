<mvc:View
    controllerName="xyraweb.controller.Reviewer1Profile"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:tnt="sap.tnt"
    height="100%">

    <tnt:ToolPage id="reviewerProfileToolPage" sideExpanded="true">

        <!-- PERSISTENT REVIEWER 1 LEFT NAVIGATION SIDEBAR -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="true" selectedKey="Profile" itemSelect="onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Automated Reports Review Queue" icon="sap-icon://table-view" key="Queue" select="onQueue"/>
                    <tnt:NavigationListItem text="Detailed Review Analysis" icon="sap-icon://inspect" key="Analysis" select="onAnalysis"/>
                    <tnt:NavigationListItem text="Reviewer History" icon="sap-icon://history" key="History" select="onHistory"/>
                </tnt:NavigationList>

                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem text="Profile" icon="sap-icon://person-placeholder" key="Profile" select="onProfile"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page
                id="reviewerProfilePage"
                showHeader="true"
                enableScrolling="true"
                class="sapUiContentPadding">

                <!-- PAGE HEADER WITH TITLE & SUBTITLE -->
                <customHeader>
                    <OverflowToolbar height="4.5rem">
                        <Button
                            tooltip="Toggle Navigation"
                            icon="sap-icon://menu2"
                            type="Transparent"
                            press="onSideNavToggle"
                            class="sapUiTinyMarginBegin"/>
                        <VBox justifyContent="Center">
                            <Title text="XYRA – Reviewer 1 Profile &amp; Account Settings" level="H4" class="sapUiNoMargin"/>
                            <Text text="Manage your user details, security credentials, and reviewer account information." class="textMuted sapUiNoMargin"/>
                        </VBox>
                        <ToolbarSpacer/>

                        <Button icon="sap-icon://home" tooltip="Back to Queue" type="Transparent" press="onBackToDashboard" class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                        <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
                    </OverflowToolbar>
                </customHeader>

                <content>
                    <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                        <!-- USER PROFILE HEADER CARD -->
                        <Panel expandable="false" class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                                <HBox alignItems="Center">
                                    <Avatar displaySize="L" initials="R1" backgroundColor="Accent1" class="sapUiMediumMarginEnd"/>
                                    <VBox>
                                        <Title text="{profileModel>/fullName}" level="H2"/>
                                        <Text text="Assigned Persona: {profileModel>/persona} • {profileModel>/department}" class="textMuted sapUiTinyMarginBottom"/>
                                        <HBox alignItems="Center">
                                            <ObjectStatus text="Online" state="Success" icon="sap-icon://sys-enter-2" class="sapUiSmallMarginEnd"/>
                                            <ObjectStatus text="Reviewer ID: {profileModel>/reviewerId}" state="Information" class="sapUiSmallMarginEnd"/>
                                            <ObjectStatus text="Account Status: {profileModel>/accountStatus}" state="Success"/>
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <VBox alignItems="End">
                                    <Button text="Edit Profile Picture" icon="sap-icon://edit" type="Transparent" press="onQuickAction"/>
                                    <Text text="Last Login: {profileModel>/lastLogin}" class="textMuted sapUiTinyMarginTop"/>
                                </VBox>
                            </HBox>
                        </Panel>

                        <!-- SECTION 1 – PERSONAL & ACCOUNT DETAILS -->
                        <Panel headerText="Personal &amp; Account Details" expandable="false" class="sapUiSmallMarginBottom">
                            <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" emptySpanL="0" emptySpanM="0" columnsL="2" columnsM="2">
                                <form:content>
                                    <core:Title text="Personal Details"/>

                                    <Label text="Full Name"/>
                                    <Input id="profFullName" value="{profileModel>/fullName}" class="xyraFormInput"/>

                                    <Label text="Email Address"/>
                                    <Input id="profEmail" type="Email" value="{profileModel>/email}" class="xyraFormInput"/>

                                    <Label text="Phone Number"/>
                                    <Input id="profPhone" type="Tel" value="{profileModel>/phone}" class="xyraFormInput"/>

                                    <Label text="Department"/>
                                    <Input id="profDepartment" value="{profileModel>/department}" class="xyraFormInput"/>

                                    <Label text="Organization"/>
                                    <Input id="profOrg" value="{profileModel>/organization}" class="xyraFormInput"/>

                                    <core:Title text="Account &amp; System Details"/>

                                    <Label text="Reviewer ID"/>
                                    <Input id="profReviewerId" value="{profileModel>/reviewerId}" editable="true" class="xyraFormInput"/>

                                    <Label text="Assigned Persona"/>
                                    <Input id="profPersona" value="{profileModel>/persona}" editable="true" class="xyraFormInput"/>

                                    <Label text="Enterprise Subdomain"/>
                                    <Input id="profSubdomain" value="{profileModel>/subdomain}" editable="true" class="xyraFormInput"/>
                                </form:content>
                            </form:SimpleForm>
                        </Panel>


                        <!-- BOTTOM ACTION BAR -->
                        <HBox justifyContent="End" class="sapUiMediumMarginTop sapUiSmallMarginBottom">
                            <Button text="Save Profile Changes" type="Emphasized" icon="sap-icon://save" press="onSaveProfile" class="sapUiTinyMarginEnd"/>
                            <Button text="Reset" type="Transparent" icon="sap-icon://reset" press="onResetProfile" class="sapUiTinyMarginEnd"/>
                            <Button text="Back to Dashboard" type="Ghost" icon="sap-icon://home" press="onBackToDashboard"/>
                        </HBox>

                    </VBox>
                </content>

                <footer>
                    <OverflowToolbar>
                        <Text text="© 2026 Forte Innovations"/>
                        <ToolbarSpacer/>
                        <ObjectStatus text="July 30, 2026" icon="sap-icon://appointment-2" state="Information"/>
                    </OverflowToolbar>
                </footer>

            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>
