<mvc:View
    controllerName="xyraweb.controller.Auditor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    height="100%">

    <Page
        id="auditorPage"
        showHeader="true"
        enableScrolling="true"
        class="sapUiContentPadding">

        <dependents>
            <!-- Auditor Profile Popover -->
            <ResponsivePopover
                id="auditorProfilePopover"
                title="Auditor Profile"
                placement="Bottom"
                contentWidth="320px">
                <content>
                    <VBox class="sapUiMediumMargin">
                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                            <Avatar displaySize="M" initials="AO" backgroundColor="Accent5" class="sapUiSmallMarginEnd"/>
                            <VBox>
                                <Title text="Internal Audit Officer" level="H3"/>
                                <Text text="Senior Internal Auditor"/>
                                <ObjectStatus text="Online" state="Success"/>
                            </VBox>
                        </HBox>
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Auditor ID" design="Bold"/>
                            <Text text="AUD001"/>
                            <Label text="Department" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="Internal Audit &amp; Compliance"/>
                            <Label text="Email" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="auditor@xyra.ai"/>
                            <Label text="Region" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="Global"/>
                            <Label text="Assigned Audits" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="12 Active Audits"/>
                            <Label text="Completed Audits" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="88 Audits Passed"/>
                            <Label text="Pending Findings" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="3 Open Findings"/>
                        </VBox>
                        <HBox justifyContent="End" class="sapUiSmallMarginTop">
                            <Button text="Logout" icon="sap-icon://log" type="Reject" press="onLogout"/>
                        </HBox>
                    </VBox>
                </content>
            </ResponsivePopover>
        </dependents>

        <customHeader>
            <OverflowToolbar height="4.5rem">
                <Avatar initials="AO" displaySize="S" backgroundColor="Accent5" class="sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
                <VBox justifyContent="Center">
                    <Title text="XYRA – Auditor Dashboard" level="H4" class="sapUiNoMargin"/>
                    <Text text="Internal Audit &amp; Compliance Portal - AI Powered Security Audit Platform" class="textMuted sapUiNoMargin"/>
                </VBox>
                <ToolbarSpacer/>

                <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onActionPress"/>
                <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout" class="sapUiTinyMarginEnd"/>
            </OverflowToolbar>
        </customHeader>

        <content>
            <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                <!-- TOP KPI DASHBOARD (6 Cards) -->
                <Title text="Audit Performance &amp; Governance Overview" level="H3" class="sapUiSmallMarginBottom"/>

                <layout:Grid defaultSpan="XL2 L4 M6 S12" class="sapUiSmallMarginBottom">
                    <f:Card class="sapUiTinyMarginBottom">
                        <f:header>
                            <card:Header
                                title="12 Active"
                                subtitle="Pending Audits"
                                iconSrc="sap-icon://inspection"
                                statusText="In Progress"/>
                        </f:header>
                    </f:Card>

                    <f:Card class="sapUiTinyMarginBottom">
                        <f:header>
                            <card:Header
                                title="88 Verified"
                                subtitle="Completed Audits"
                                iconSrc="sap-icon://accept"
                                statusText="Archived"/>
                        </f:header>
                    </f:Card>

                    <f:Card class="sapUiTinyMarginBottom">
                        <f:header>
                            <card:Header
                                title="2 Critical"
                                subtitle="Critical Findings"
                                iconSrc="sap-icon://alert"
                                statusText="Action Required"/>
                        </f:header>
                    </f:Card>

                    <f:Card class="sapUiTinyMarginBottom">
                        <f:header>
                            <card:Header
                                title="3 Open"
                                subtitle="Open Findings"
                                iconSrc="sap-icon://warning"
                                statusText="Pending Response"/>
                        </f:header>
                    </f:Card>

                    <f:Card class="sapUiTinyMarginBottom">
                        <f:header>
                            <card:Header
                                title="96.8%"
                                subtitle="Compliance Score"
                                iconSrc="sap-icon://sys-enter-2"
                                statusText="Target: 95%"/>
                        </f:header>
                    </f:Card>

                    <f:Card class="sapUiTinyMarginBottom">
                        <f:header>
                            <card:Header
                                title="82% Complete"
                                subtitle="Audit Progress"
                                iconSrc="sap-icon://line-chart"
                                statusText="Q3 Cycle"/>
                        </f:header>
                    </f:Card>
                </layout:Grid>

                <!-- FILTER BAR -->
                <Panel headerText="Filter Audit Records" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                    <layout:Grid defaultSpan="XL3 L3 M6 S12">
                        <SearchField placeholder="Search audit logs..." search="onRefresh"/>
                        <Input placeholder="Audit ID (e.g. AUD-101)"/>
                        <Input placeholder="Business User"/>
                        <Input placeholder="Application (e.g. SAP ECC)"/>
                        <Input placeholder="Control ID (e.g. SOX-001)"/>
                        <Select width="100%">
                            <core:Item key="" text="All Risk Levels"/>
                            <core:Item key="High" text="High"/>
                            <core:Item key="Medium" text="Medium"/>
                            <core:Item key="Low" text="Low"/>
                        </Select>
                        <Select width="100%">
                            <core:Item key="" text="All Compliance Statuses"/>
                            <core:Item key="Compliant" text="Compliant"/>
                            <core:Item key="NonCompliant" text="Non-Compliant"/>
                        </Select>
                        <DatePicker placeholder="Audit Date" width="100%"/>
                    </layout:Grid>
                    <OverflowToolbar class="sapUiTinyMarginTop">
                        <ToolbarSpacer/>
                        <Button text="Search" type="Emphasized" icon="sap-icon://search" press="onRefresh"/>
                        <Button text="Reset" type="Transparent" icon="sap-icon://reset" press="onActionPress"/>
                        <Button text="Export" icon="sap-icon://excel-attachment" press="onActionPress"/>
                    </OverflowToolbar>
                </Panel>

                <!-- QUICK ACTIONS -->
                <Panel expandable="false" class="sapUiSmallMarginBottom">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Auditor Quick Actions" level="H5"/>
                            <ToolbarSpacer/>
                            <Button text="Start Audit" type="Emphasized" icon="sap-icon://play" press="onActionPress" class="sapUiTinyMarginEnd"/>
                            <Button text="Raise Finding" type="Reject" icon="sap-icon://add-filter" press="onActionPress" class="sapUiTinyMarginEnd"/>
                            <Button text="Generate Report" icon="sap-icon://pdf-attachment" press="onActionPress" class="sapUiTinyMarginEnd"/>
                            <Button text="Download Evidence" icon="sap-icon://download" press="onActionPress" class="sapUiTinyMarginEnd"/>
                            <Button text="Export Report" icon="sap-icon://excel-attachment" press="onActionPress" class="sapUiTinyMarginEnd"/>
                            <Button text="Assign Review" icon="sap-icon://personnel" press="onActionPress"/>
                        </OverflowToolbar>
                    </headerToolbar>
                </Panel>

                <!-- MAIN TABLE -->
                <Panel headerText="Audit Review Queue &amp; Compliance Logs" expandable="false" class="sapUiSmallMarginBottom">
                    <Table id="auditorTable" inset="false" width="100%">
                        <columns>
                            <Column width="10%"><Text text="Audit ID"/></Column>
                            <Column width="10%"><Text text="Control ID"/></Column>
                            <Column width="12%"><Text text="Application"/></Column>
                            <Column width="18%"><Text text="Business Process"/></Column>
                            <Column width="12%"><Text text="Business User"/></Column>
                            <Column width="12%"><Text text="Control Owner"/></Column>
                            <Column width="10%"><Text text="Risk"/></Column>
                            <Column width="16%"><Text text="Compliance %"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="AUD-101" subtitle="SOX"/>
                                    <Text text="SOX-001"/>
                                    <Text text="SAP ECC"/>
                                    <Text text="User Access Review"/>
                                    <Text text="John Smith"/>
                                    <Text text="Reviewer 2"/>
                                    <ObjectStatus text="Low" state="Success" icon="sap-icon://sys-enter"/>
                                    <ProgressIndicator percentValue="98" displayValue="98%" state="Success"/>
                                </cells>
                            </ColumnListItem>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="AUD-102" subtitle="SOD"/>
                                    <Text text="SOX-002"/>
                                    <Text text="SAP S/4HANA"/>
                                    <Text text="Emergency Access Log Review"/>
                                    <Text text="Jane Doe"/>
                                    <Text text="Reviewer 1"/>
                                    <ObjectStatus text="High" state="Error" icon="sap-icon://alert"/>
                                    <ProgressIndicator percentValue="65" displayValue="65%" state="Warning"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- AI INSIGHTS & AUDIT TIMELINE -->
                <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMarginBottom">
                    <Panel headerText="AI Audit Analytics &amp; Risk Insights" expandable="true" expanded="true">
                        <VBox class="sapUiSmallMargin">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                <Label text="Overall Audit Compliance Score" design="Bold"/>
                                <ObjectStatus text="96.8% Compliant" state="Success"/>
                            </HBox>
                            <ProgressIndicator percentValue="97" displayValue="97%" state="Success" class="sapUiSmallMarginBottom"/>

                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                <Label text="AI Deficiencies Prediction" design="Bold"/>
                                <ObjectStatus text="Zero Critical Anomalies" state="Success"/>
                            </HBox>
                            <Text text="AI Audit Scanner completed analysis on 1,420 user accounts across SAP ECC &amp; S/4HANA. All controls comply with SOX 404 specs." class="sapUiSmallMarginBottom"/>
                            <MessageStrip text="Control Effectiveness score calculated at 98.2%. Confidence rating: 99%." type="Success" showIcon="true"/>
                        </VBox>
                    </Panel>

                    <Panel headerText="Audit Lifecycle Timeline" expandable="true" expanded="true">
                        <VBox class="sapUiSmallMargin">
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <core:Icon src="sap-icon://accept" color="green" class="sapUiSmallMarginEnd"/>
                                <Text text="Step 1: Audit Scope &amp; Schedule Created"/>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <core:Icon src="sap-icon://accept" color="green" class="sapUiSmallMarginEnd"/>
                                <Text text="Step 2: Evidence Collected &amp; Validated"/>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <core:Icon src="sap-icon://process" color="orange" class="sapUiSmallMarginEnd"/>
                                <Text text="Step 3: Internal Control Testing (Active)"/>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <core:Icon src="sap-icon://future" color="gray" class="sapUiSmallMarginEnd"/>
                                <Text text="Step 4: Final Management Report &amp; Closure"/>
                            </HBox>
                        </VBox>
                    </Panel>
                </layout:Grid>

            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <Text text="© 2026 Forte Innovations"/>
                <ToolbarSpacer/>
                <Text text="XYRA Internal Audit Platform | Version 1.0 | Status: Active"/>
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>