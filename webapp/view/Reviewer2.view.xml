<mvc:View
    controllerName="xyraweb.controller.Reviewer2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    height="100%">

    <Page
        id="reviewer2Page"
        showHeader="true"
        enableScrolling="true"
        class="sapUiContentPadding">

        <dependents>
            <!-- Reviewer 2 Profile Popover -->
            <ResponsivePopover
                id="rev2ProfilePopover"
                title="Reviewer 2 Profile"
                placement="Bottom"
                contentWidth="340px">
                <content>
                    <VBox class="sapUiMediumMargin">
                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                            <Avatar displaySize="M" initials="R2" backgroundColor="Accent3" class="sapUiSmallMarginEnd"/>
                            <VBox>
                                <Title text="Manager Exception Reviewer" level="H3"/>
                                <Text text="Reviewer 2 - Second Level Review"/>
                                <ObjectStatus text="Active Duty" state="Success"/>
                            </VBox>
                        </HBox>
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Role" design="Bold"/>
                            <Text text="Manager Exception Reviewer (Level 2 Reviewer)"/>
                            <Label text="Department" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="SAP Technical Operations &amp; Compliance Governance"/>
                            <Label text="Email" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="basis.manager@xyra.ai"/>
                            <Label text="Responsibilities" design="Bold" class="sapUiTinyMarginTop"/>
                            <Text text="Perform second-level review of exception records after Control Exception Reviewer (Reviewer 1) has completed first-level review."/>
                        </VBox>
                        <HBox justifyContent="End" class="sapUiSmallMarginTop">
                            <Button text="Logout" icon="sap-icon://log" type="Reject" press="onLogout"/>
                        </HBox>
                    </VBox>
                </content>
            </ResponsivePopover>

            <!-- VIEW REPORT DIALOG -->
            <Dialog id="viewReportDialog" title="Exception Report Details" contentWidth="560px">
                <content>
                    <VBox class="sapUiMediumMargin">
                        <Title text="{reviewer2Model>/selectedReport/reportName}" level="H3" class="sapUiTinyMarginBottom"/>
                        <ObjectStatus text="{reviewer2Model>/selectedReport/reportId}" state="Information" class="sapUiSmallMarginBottom"/>

                        <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMarginBottom">
                            <VBox>
                                <Label text="Control ID" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/controlId}"/>
                                <Label text="SAP System" design="Bold" class="sapUiTinyMarginTop"/>
                                <Text text="{reviewer2Model>/selectedReport/system}"/>
                                <Label text="Reviewer 1 Decision" design="Bold" class="sapUiTinyMarginTop"/>
                                <ObjectStatus text="{reviewer2Model>/selectedReport/reviewer1Decision}" state="Success"/>
                            </VBox>
                            <VBox>
                                <Label text="Business Process" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/businessProcess}"/>
                                <Label text="Generated Date" design="Bold" class="sapUiTinyMarginTop"/>
                                <Text text="{reviewer2Model>/selectedReport/generatedDate}"/>
                                <Label text="Reviewer 2 Status" design="Bold" class="sapUiTinyMarginTop"/>
                                <ObjectStatus text="{reviewer2Model>/selectedReport/reviewer2Status}" state="{reviewer2Model>/selectedReport/reviewer2State}"/>
                            </VBox>
                        </layout:Grid>

                        <Label text="Reviewer 1 Comments" design="Bold"/>
                        <Text text="{reviewer2Model>/selectedReport/rev1Comments}" class="sapUiSmallMarginBottom"/>

                        <Label text="Reviewer 1 Root Cause Analysis" design="Bold"/>
                        <Text text="{reviewer2Model>/selectedReport/rev1RcaText}"/>
                    </VBox>
                </content>
                <endButton>
                    <Button text="Close" press="onCloseViewReportDialog"/>
                </endButton>
            </Dialog>

            <!-- VIEW EVIDENCE DIALOG -->
            <Dialog id="viewEvidenceDialog" title="Supporting Evidence Review" contentWidth="520px">
                <content>
                    <VBox class="sapUiMediumMargin">
                        <Title text="Evidence Files &amp; Audit Logs" level="H4" class="sapUiSmallMarginBottom"/>
                        <MessageStrip text="Verified supporting evidence extracted from production SAP audit file buffer." type="Success" showIcon="true" class="sapUiSmallMarginBottom"/>
                        
                        <List items="{reviewer2Model>/selectedReport/evidenceFiles}">
                            <StandardListItem title="{title}" description="{description}" icon="sap-icon://pdf-attachment" info="{status}" infoState="Success"/>
                        </List>
                    </VBox>
                </content>
                <endButton>
                    <Button text="Close" press="onCloseViewEvidenceDialog"/>
                </endButton>
            </Dialog>

            <!-- REQUEST ADDITIONAL EVIDENCE DIALOG -->
            <Dialog id="requestEvidenceDialog" title="Request Additional Evidence" contentWidth="480px">
                <content>
                    <VBox class="sapUiMediumMargin">
                        <Label text="Specify Required Evidence / Logs" required="true"/>
                        <TextArea id="inputRequestEvidenceArea" rows="4" width="100%" placeholder="Describe additional evidence, log traces, or system dumps required..." class="sapUiSmallMarginBottom"/>
                    </VBox>
                </content>
                <beginButton>
                    <Button text="Send Request" type="Emphasized" press="onSubmitRequestEvidence"/>
                </beginButton>
                <endButton>
                    <Button text="Cancel" press="onCloseRequestEvidenceDialog"/>
                </endButton>
            </Dialog>

            <!-- APPROVE & FORWARD TO ESCALATION MANAGER DIALOG -->
            <Dialog id="approveDialog" title="Approve &amp; Forward to Escalation Manager" contentWidth="540px">
                <content>
                    <VBox class="sapUiMediumMargin">
                        <MessageStrip text="Confirm second-level manager approval and forward report to Escalation Manager." type="Success" showIcon="true" class="sapUiSmallMarginBottom"/>
                        
                        <Title text="Exception Report Summary" level="H4" class="sapUiTinyMarginBottom"/>
                        <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMarginBottom">
                            <VBox>
                                <Label text="Report ID" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/reportId}"/>
                                <Label text="Control ID" design="Bold" class="sapUiTinyMarginTop"/>
                                <Text text="{reviewer2Model>/selectedReport/controlId}"/>
                            </VBox>
                            <VBox>
                                <Label text="Report Name" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/reportName}"/>
                                <Label text="SAP System" design="Bold" class="sapUiTinyMarginTop"/>
                                <Text text="{reviewer2Model>/selectedReport/system}"/>
                            </VBox>
                        </layout:Grid>

                        <Label text="Manager Root Cause Analysis" design="Bold" class="sapUiTinyMarginTop"/>
                        <MessageStrip text="{reviewer2Model>/selectedReport/rev2RcaText}" type="None" class="sapUiSmallMarginBottom"/>

                        <Label text="Electronic Signature Confirmation" design="Bold"/>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon src="sap-icon://sys-enter-2" color="#107e3e" class="sapUiSmallMarginEnd"/>
                            <Text text="Confirmed by {reviewer2Model>/selectedReport/reviewer2Name} ({reviewer2Model>/selectedReport/employeeId}) on {reviewer2Model>/selectedReport/decisionDate}"/>
                        </HBox>
                    </VBox>
                </content>
                <beginButton>
                    <Button text="Approve &amp; Forward" type="Accept" icon="sap-icon://accept" press="onConfirmApproveForward"/>
                </beginButton>
                <endButton>
                    <Button text="Cancel" press="onCloseApproveDialog"/>
                </endButton>
            </Dialog>

            <!-- REJECT & RETURN TO REVIEWER 1 DIALOG -->
            <Dialog id="rejectDialog" title="Reject &amp; Return to Reviewer 1" contentWidth="540px">
                <content>
                    <VBox class="sapUiMediumMargin">
                        <MessageStrip text="Reject report and return to Reviewer 1 for correction." type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/>
                        
                        <Title text="Exception Report Summary" level="H4" class="sapUiTinyMarginBottom"/>
                        <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMarginBottom">
                            <VBox>
                                <Label text="Report ID" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/reportId}"/>
                            </VBox>
                            <VBox>
                                <Label text="Report Name" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/reportName}"/>
                            </VBox>
                        </layout:Grid>

                        <Label text="Manager Root Cause Analysis / Rejection Reason" design="Bold" class="sapUiTinyMarginTop"/>
                        <MessageStrip text="{reviewer2Model>/selectedReport/rev2RcaText}" type="None" class="sapUiSmallMarginBottom"/>

                        <Label text="Electronic Signature Confirmation" design="Bold"/>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon src="sap-icon://sys-enter-2" color="#107e3e" class="sapUiSmallMarginEnd"/>
                            <Text text="Confirmed by {reviewer2Model>/selectedReport/reviewer2Name} ({reviewer2Model>/selectedReport/employeeId}) on {reviewer2Model>/selectedReport/decisionDate}"/>
                        </HBox>
                    </VBox>
                </content>
                <beginButton>
                    <Button text="Reject &amp; Return" type="Reject" icon="sap-icon://undo" press="onSubmitReject"/>
                </beginButton>
                <endButton>
                    <Button text="Cancel" press="onCloseRejectDialog"/>
                </endButton>
            </Dialog>
        </dependents>

        <customHeader>
            <OverflowToolbar height="4.5rem">
                <!-- Left Side Profile Button -->
                <Button
                    text="REV2"
                    icon="sap-icon://employee"
                    type="Transparent"
                    press="onProfilePress"
                    class="sapUiTinyMarginBegin"/>

                <Avatar initials="R2" displaySize="S" backgroundColor="Accent3" class="sapUiTinyMarginEnd"/>

                <VBox justifyContent="Center">
                    <Title text="📜 XYRA – Reviewer 2 Dashboard" level="H4" class="sapUiNoMargin"/>
                    <Text text="Manager Exception Reviewer – Second Level Review &amp; Approval" class="textMuted sapUiNoMargin"/>
                </VBox>

                <ToolbarSpacer/>

                <Button icon="sap-icon://bell" tooltip="Notifications" type="Transparent" press="onNotificationPress"/>
                <Button text="Logout" type="Reject" icon="sap-icon://log" press="onLogout" class="sapUiTinyMarginEnd"/>
            </OverflowToolbar>
        </customHeader>

        <content>
            <VBox width="100%" class="sapUiMediumMarginTop sapUiResponsiveContentPadding">

                <!-- BUSINESS ROLE & PURPOSE BANNER -->
                <MessageStrip
                    text="Business Role: Manager Exception Reviewer | Purpose: Perform the second-level review of exception records after the Control Exception Reviewer (Reviewer 1) has completed the first-level review."
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiSmallMarginBottom"/>

                <!-- TOP SLIDE NAVIGATION PILL BUTTONS -->
                <HBox justifyContent="Start" alignItems="Center" class="sapUiSmallMarginBottom">
                    <Button id="btnTabReviewQueue" text="Review Queue" icon="sap-icon://table-view" type="Emphasized" press="onSelectTabQueue" class="sapUiTinyMarginEnd"/>
                    <Button id="btnTabDetailedAnalysis" text="Detailed Review Analysis" icon="sap-icon://inspect" type="Transparent" press="onSelectTabAnalysis"/>
                </HBox>

                <!-- SLIDE 1: REVIEW QUEUE -->
                <VBox id="vboxReviewQueue" visible="true" width="100%">

                    <!-- FILTER BAR -->
                    <Panel headerText="Filter Reviewer 2 Queue" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                        <layout:Grid defaultSpan="XL3 L3 M6 S12">
                            <SearchField id="searchReviewer2" placeholder="Search technical reports..." search="onSearchReports"/>
                            <Input id="inputReportIdFilter2" placeholder="Report ID (e.g. REP-101)"/>
                            <Select id="selectSystemFilter2" width="100%" change="onFilterSystem">
                                <core:Item key="All" text="All Systems"/>
                                <core:Item key="PRD-100 (Java)" text="PRD-100 (Java)"/>
                                <core:Item key="HDB-10 (HANA)" text="HDB-10 (HANA)"/>
                                <core:Item key="QAS-200 (Java)" text="QAS-200 (Java)"/>
                            </Select>
                            <Select id="selectStatusFilter2" width="100%" change="onFilterStatus">
                                <core:Item key="All" text="All Reviewer Statuses"/>
                                <core:Item key="Pending Technical Review" text="Pending Technical Review"/>
                                <core:Item key="Approved &amp; Forwarded" text="Approved &amp; Forwarded"/>
                                <core:Item key="Returned to Reviewer 1" text="Returned to Reviewer 1"/>
                                <core:Item key="Rejected" text="Rejected"/>
                            </Select>
                        </layout:Grid>
                        <OverflowToolbar class="sapUiTinyMarginTop">
                            <ToolbarSpacer/>
                            <Button text="Search" type="Emphasized" icon="sap-icon://search" press="onSearchReports"/>
                            <Button text="Reset Filters" type="Transparent" icon="sap-icon://reset" press="onResetFilters"/>
                        </OverflowToolbar>
                    </Panel>

                    <!-- SECTION 8: DECISION BUTTONS TOOLBAR -->
                    <Panel expandable="false" class="sapUiSmallMarginBottom">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Reviewer 2 Decision Actions" level="H4"/>
                                <ToolbarSpacer/>
                                <Button text="View Report" icon="sap-icon://show" press="onViewReport" class="sapUiTinyMarginEnd"/>
                                <Button text="View Evidence" icon="sap-icon://document" press="onViewEvidence" class="sapUiTinyMarginEnd"/>
                                <Button text="Approve &amp; Forward to Escalation Manager" type="Accept" icon="sap-icon://accept" press="onApproveForward" class="sapUiTinyMarginEnd"/>
                                <Button text="Reject &amp; Return to Reviewer 1" type="Reject" icon="sap-icon://undo" press="onRejectReport" class="sapUiTinyMarginEnd"/>
                                <Button text="Request Additional Evidence" icon="sap-icon://hint" press="onRequestEvidence"/>
                            </OverflowToolbar>
                        </headerToolbar>
                    </Panel>

                    <!-- SECTION 2: REVIEW QUEUE TABLE -->
                    <Panel headerText="Exception Records Review Queue (Click Row for Detailed Analysis Slide)" expandable="false" class="sapUiSmallMarginBottom">
                        <Table
                            id="reviewer2Table"
                            items="{reviewer2Model>/reports}"
                            mode="MultiSelect"
                            width="100%"
                            selectionChange="onSelectionChange">
                            <columns>
                                <Column width="10%"><Text text="Report ID"/></Column>
                                <Column width="18%"><Text text="Report Name"/></Column>
                                <Column width="9%"><Text text="Control ID"/></Column>
                                <Column width="11%"><Text text="SAP System"/></Column>
                                <Column width="11%"><Text text="Generated Date"/></Column>
                                <Column width="12%"><Text text="Reviewer 1 Decision"/></Column>
                                <Column width="14%"><Text text="Reviewer 1 Comments"/></Column>
                                <Column width="9%"><Text text="Evidence Status"/></Column>
                                <Column width="11%"><Text text="Reviewer 2 Status"/></Column>
                            </columns>

                            <items>
                                <ColumnListItem press="onReportRowPress" type="Navigation">
                                    <cells>
                                        <ObjectStatus text="{reviewer2Model>reportId}" state="Information"/>
                                        <ObjectIdentifier title="{reviewer2Model>reportName}" subtitle="{reviewer2Model>controlName}"/>
                                        <ObjectStatus text="{reviewer2Model>controlId}" state="None"/>
                                        <Text text="{reviewer2Model>system}"/>
                                        <Text text="{reviewer2Model>generatedDate}"/>
                                        <ObjectStatus text="{reviewer2Model>reviewer1Decision}" state="Success" icon="sap-icon://sys-enter-2"/>
                                        <Text text="{reviewer2Model>rev1Comments}"/>
                                        <ObjectStatus text="{reviewer2Model>evidenceStatus}" state="Success"/>
                                        <ObjectStatus text="{reviewer2Model>reviewer2Status}" state="{reviewer2Model>reviewer2State}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </Panel>

                </VBox>

                <!-- SLIDE 2: DETAILED REVIEW ANALYSIS (PROPER DOWNWARD ALIGNMENT) -->
                <VBox id="vboxDetailedAnalysis" visible="false" width="100%">

                    <!-- SLIDE BREADCRUMB HEADER -->
                    <OverflowToolbar class="sapUiSmallMarginBottom">
                        <Title text="Detailed Review Analysis – {reviewer2Model>/selectedReport/reportId} ({reviewer2Model>/selectedReport/reportName})" level="H4"/>
                        <ToolbarSpacer/>
                        <ObjectStatus text="{reviewer2Model>/selectedReport/system}" state="Information" class="sapUiTinyMarginEnd"/>
                        <ObjectStatus text="{reviewer2Model>/selectedReport/reviewer2Status}" state="{reviewer2Model>/selectedReport/reviewer2State}"/>
                    </OverflowToolbar>

                    <!-- SECTION 3: REPORT DETAILS PANEL (DOWNWARD ALIGNMENT) -->
                    <Panel headerText="3. Report Details" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                        <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiTinyMargin">
                            <VBox>
                                <Label text="Control Information" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/controlId} - {reviewer2Model>/selectedReport/controlName}" class="sapUiSmallMarginBottom"/>

                                <Label text="Business Process" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/businessProcess}" class="sapUiSmallMarginBottom"/>

                                <Label text="Risk Level" design="Bold"/>
                                <ObjectStatus text="{reviewer2Model>/selectedReport/riskLevel}" state="{reviewer2Model>/selectedReport/riskState}" icon="sap-icon://alert"/>
                            </VBox>

                            <VBox>
                                <Label text="SAP System" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/system}" class="sapUiSmallMarginBottom"/>

                                <Label text="Generated Date" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/generatedDate}" class="sapUiSmallMarginBottom"/>

                                <Label text="Current Reviewer 2 Status" design="Bold"/>
                                <ObjectStatus text="{reviewer2Model>/selectedReport/reviewer2Status}" state="{reviewer2Model>/selectedReport/reviewer2State}"/>
                            </VBox>
                        </layout:Grid>
                    </Panel>

                    <!-- SECTION 2: REVIEWER 1 REVIEW SUMMARY (DOWNWARD ALIGNMENT) -->
                    <Panel headerText="2. Reviewer 1 Review Summary" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                        <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiTinyMargin">
                            <VBox>
                                <Label text="Reviewer 1 Decision" design="Bold"/>
                                <ObjectStatus text="{reviewer2Model>/selectedReport/reviewer1Decision}" state="Success" icon="sap-icon://sys-enter-2" class="sapUiSmallMarginBottom"/>

                                <Label text="Reviewer 1 Electronic Signature" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/rev1Signature}" class="sapUiSmallMarginBottom"/>
                            </VBox>

                            <VBox>
                                <Label text="Review Date" design="Bold"/>
                                <Text text="{reviewer2Model>/selectedReport/rev1Date}" class="sapUiSmallMarginBottom"/>

                                <Label text="Reviewer 1 Root Cause Analysis" design="Bold"/>
                                <MessageStrip text="{reviewer2Model>/selectedReport/rev1RcaText}" type="Information"/>
                            </VBox>
                        </layout:Grid>
                    </Panel>

                    <!-- SECTION 3: ROOT CAUSE ANALYSIS (MANDATORY) (DOWNWARD ALIGNMENT) -->
                    <Panel headerText="3. Root Cause Analysis (Mandatory)" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                        <VBox class="sapUiTinyMargin">
                            <MessageStrip text="Mandatory: Root Cause Analysis is required prior to approving or rejecting this review." type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/>
                            <Label text="Root Cause Analysis (Mandatory)" required="true" design="Bold"/>
                            <TextArea
                                id="inputRcaArea2"
                                value="{reviewer2Model>/selectedReport/rev2RcaText}"
                                rows="4"
                                width="100%"
                                placeholder="Enter detailed manager Root Cause Analysis explaining second-level validation results, risk assessment, or rejection rationale..."
                                class="sapUiSmallMarginBottom"/>
                        </VBox>
                    </Panel>

                    <!-- SECTION 4: ELECTRONIC SIGNATURE PANEL (DOWNWARD ALIGNMENT) -->
                    <Panel headerText="4. Electronic Signature Panel" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                        <VBox class="sapUiTinyMargin">
                            <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMarginBottom">
                                <VBox>
                                    <Label text="Reviewer Name" design="Bold"/>
                                    <Text text="{reviewer2Model>/selectedReport/reviewer2Name}"/>
                                    
                                    <Label text="Employee ID" design="Bold" class="sapUiTinyMarginTop"/>
                                    <Text text="{reviewer2Model>/selectedReport/employeeId}"/>
                                </VBox>
                                <VBox>
                                    <Label text="Decision Date" design="Bold"/>
                                    <Text text="{reviewer2Model>/selectedReport/decisionDate}"/>

                                    <Label text="Digital Signature Status" design="Bold" class="sapUiTinyMarginTop"/>
                                    <ObjectStatus text="{reviewer2Model>/selectedReport/sigStatus}" state="Success" icon="sap-icon://sys-enter-2"/>
                                </VBox>
                            </layout:Grid>

                            <CheckBox
                                id="chkElecSignature2"
                                text="I confirm that I have personally reviewed this exception."
                                selected="{reviewer2Model>/selectedReport/elecSigConfirmed}"
                                class="sapUiTinyMarginTop"/>
                        </VBox>
                    </Panel>

                    <!-- SECTION 5: REVIEW HISTORY (DOWNWARD ALIGNMENT) -->
                    <Panel headerText="5. Review History" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                        <Table items="{reviewer2Model>/selectedReport/reviewHistory}" inset="false" width="100%">
                            <columns>
                                <Column width="30%"><Text text="Previous Actions"/></Column>
                                <Column width="35%"><Text text="Reviewer Comments"/></Column>
                                <Column width="35%"><Text text="Status Timeline"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{action}"/>
                                        <Text text="{comments}"/>
                                        <ObjectStatus text="{statusTimeline}" state="Information"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </Panel>

                    <!-- BOTTOM ACTION BAR IN DETAILED ANALYSIS SLIDE -->
                    <OverflowToolbar class="sapUiSmallMarginTop">
                        <Button text="Back to Review Queue" icon="sap-icon://nav-back" press="onSelectTabQueue" class="sapUiTinyMarginEnd"/>
                        <ToolbarSpacer/>
                        <Button text="Approve &amp; Forward to Escalation Manager" type="Accept" icon="sap-icon://accept" press="onApproveForward" class="sapUiTinyMarginEnd"/>
                        <Button text="Reject &amp; Return to Reviewer 1" type="Reject" icon="sap-icon://undo" press="onRejectReport"/>
                    </OverflowToolbar>

                </VBox>

            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <Text text="© 2026 Forte Innovations"/>
                <ToolbarSpacer/>
                <Text text="XYRA Internal Control Platform | Reviewer 2 (Manager Exception Reviewer) Portal v1.0"/>
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>